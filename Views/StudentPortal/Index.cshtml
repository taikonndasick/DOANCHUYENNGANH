@{
    Layout = null;
}

<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Cổng sinh viên KTX HUTECH</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css" />
    <style>
        body {
            min-height: 100vh;
            background: linear-gradient(rgba(15, 76, 129, .15), rgba(15, 76, 129, .45)), url('@Url.Content("~/login/images/bg-01.jpg")') center/cover no-repeat;
            font-family: 'Segoe UI', sans-serif;
        }
        .portal-shell { min-height: 100vh; display: flex; align-items: center; justify-content: center; padding: 40px 16px; }
        .portal-card { max-width: 1100px; width: 100%; background: rgba(255,255,255,.94); border-radius: 28px; box-shadow: 0 25px 80px rgba(15,76,129,.25); overflow: hidden; }
        .portal-header { background: linear-gradient(135deg, #0f4c81, #1a73e8); color: white; padding: 34px; }
        .choice-card { border: 1px solid #e2e8f0; border-radius: 22px; padding: 28px; height: 100%; transition: .25s; background: white; }
        .choice-card:hover { transform: translateY(-4px); box-shadow: 0 16px 40px rgba(15,76,129,.12); border-color: #bfdbfe; }
        .choice-icon { width: 58px; height: 58px; border-radius: 18px; display: flex; align-items: center; justify-content: center; font-size: 28px; margin-bottom: 18px; }
        .bg-soft-blue { background: #e0f2fe; color: #0369a1; }
        .bg-soft-green { background: #dcfce7; color: #15803d; }
        .btn-main { border-radius: 14px; padding: 12px 18px; font-weight: 700; }
    </style>
</head>
<body>
<div class="portal-shell">
    <div class="portal-card">
        <div class="portal-header">
            <div class="d-flex align-items-center gap-3">
                <img src="~/images/logohutech.jpg" alt="Logo" style="width:54px;height:54px;border-radius:14px;object-fit:cover;background:#fff;padding:4px;" />
                <div>
                    <h1 class="h3 fw-bold mb-1">Trang thông tin sinh viên KTX</h1>
                    <div class="opacity-75">Chọn đúng nhóm sinh viên để tiếp tục sử dụng hệ thống</div>
                </div>
            </div>
        </div>

        <div class="p-4 p-lg-5">
            <div class="row g-4">
                <div class="col-lg-6">
                    <div class="choice-card">
                        <div class="choice-icon bg-soft-blue"><i class="bi bi-person-plus-fill"></i></div>
                        <h2 class="h4 fw-bold">Dành cho sinh viên chưa ở KTX</h2>
                        <p class="text-muted mb-4">
                            Xem thông tin hồ sơ cần chuẩn bị, khoản thu dự kiến, quy trình xét duyệt và gửi hồ sơ đăng ký cư trú trực tuyến.
                        </p>
                        <a asp-controller="Register" asp-action="Index" class="btn btn-primary btn-main w-100">
                            Xem thông tin & đăng ký <i class="bi bi-arrow-right ms-1"></i>
                        </a>
                    </div>
                </div>
                <div class="col-lg-6">
                    <div class="choice-card">
                        <div class="choice-icon bg-soft-green"><i class="bi bi-box-arrow-in-right"></i></div>
                        <h2 class="h4 fw-bold">Dành cho sinh viên đang ở KTX</h2>
                        <p class="text-muted mb-4">
                            Đăng nhập để xem thông tin lưu trú, phòng ở, hóa đơn, thông báo và gửi các biểu mẫu liên quan trong quá trình cư trú.
                        </p>
                        <a asp-controller="Auth" asp-action="Login" class="btn btn-success btn-main w-100">
                            Đăng nhập hệ thống <i class="bi bi-box-arrow-in-right ms-1"></i>
                        </a>
                    </div>
                </div>
            </div>

            <div class="mt-4 text-center">
                <a asp-controller="Home" asp-action="Landing" class="text-decoration-none text-muted">
                    <i class="bi bi-arrow-left"></i> Quay lại trang giới thiệu
                </a>
            </div>
        </div>
    </div>
</div>
</body>
</html>

@{
    Layout = null;
    ViewData["Title"] = "Trang chủ";
}

<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Hệ thống quản lý chung cư</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.7/dist/css/bootstrap.min.css" />
    <style>
            body {
                background: linear-gradient(135deg, #0d6efd, #6f42c1);
                min-height: 100vh;
                color: white;
            }

            .hero {
                min-height: 100vh;
                display: flex;
                align-items: center;
            }

            .hero-box {
                background: rgba(255,255,255,0.08);
                border-radius: 20px;
                padding: 50px;
                backdrop-filter: blur(8px);
                box-shadow: 0 10px 30px rgba(0,0,0,0.2);
            }

            .btn-custom {
                padding: 12px 28px;
                border-radius: 12px;
                font-weight: 600;
            }
    </style>
</head>
<body>
    <div class="container hero">
        <div class="row w-100 align-items-center">
            <div class="col-lg-7">
                <div class="hero-box">
                    <h1 class="display-5 fw-bold mb-3">Hệ thống quản lý chung cư</h1>
                    <p class="lead mb-4">
                        Nền tảng hỗ trợ quản lý cư dân, xe cộ, thẻ cư dân, dịch vụ, booking,
                        hóa đơn và thanh toán trong chung cư.
                    </p>

                    <div class="d-flex gap-3 flex-wrap">
                        <a asp-controller="Account" asp-action="Login" class="btn btn-light btn-custom">
                            Đăng nhập
                        </a>
                        <a href="#features" class="btn btn-outline-light btn-custom">
                            Xem chức năng
                        </a>
                    </div>
                </div>
            </div>

            <div class="col-lg-5 mt-4 mt-lg-0">
                <div class="hero-box text-center">
                    <h4 class="mb-3">Chức năng nổi bật</h4>
                    <p>• Quản lý cư dân</p>
                    <p>• Quản lý xe cộ</p>
                    <p>• Thẻ cư dân điện tử</p>
                    <p>• Dịch vụ & booking</p>
                    <p>• Hóa đơn & thanh toán</p>
                    <p>• Dashboard thống kê</p>
                </div>
            </div>
        </div>
    </div>

    <div id="features" class="container pb-5">
        <div class="row g-4">
            <div class="col-md-4">
                <div class="hero-box h-100">
                    <h5>Quản lý cư dân</h5>
                    <p>Theo dõi thông tin cá nhân, trạng thái cư trú và thẻ cư dân điện tử.</p>
                </div>
            </div>
            <div class="col-md-4">
                <div class="hero-box h-100">
                    <h5>Dịch vụ nội khu</h5>
                    <p>Hỗ trợ booking dịch vụ, quản lý trạng thái xử lý và lịch sử sử dụng.</p>
                </div>
            </div>
            <div class="col-md-4">
                <div class="hero-box h-100">
                    <h5>Tài chính</h5>
                    <p>Quản lý hóa đơn, thanh toán và thống kê phục vụ công tác vận hành.</p>
                </div>
            </div>
        </div>
    </div>
</body>
</html>
@model List<QuanLyKTX.Models.Apartment>
@{
    Layout = null;
    ViewData["Title"] = "Danh sách tòa nhà và phòng KTX";
    var keyword = ViewBag.Keyword as string;
    bool onlyAvailable = ViewBag.OnlyAvailable == true;
}
<!doctype html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Danh sách phòng KTX</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.7/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.13.1/font/bootstrap-icons.min.css" rel="stylesheet" />
    <style>
        body { background:#f4f8fc; }
        .topbar { background:linear-gradient(90deg,#075aaa,#1677e8); color:#fff; padding:28px 0; }
        .card-room { border:1px solid #dce8f5; border-radius:18px; box-shadow:0 12px 28px rgba(15,76,129,.07); }
        .slot-badge { font-size:.9rem; border-radius:999px; padding:.45rem .75rem; }
        .table thead th { background:#0f568f; color:#fff; }
    </style>
</head>
<body>
    <header class="topbar">
        <div class="container d-flex justify-content-between align-items-center gap-3 flex-wrap">
            <div>
                <div class="text-uppercase small fw-bold opacity-75">Trang thông tin sinh viên</div>
                <h2 class="fw-black mb-1">Danh sách tòa nhà, phòng và slot còn trống</h2>
                <div class="opacity-75">Sinh viên có thể tham khảo trước tình trạng phòng trước khi gửi hồ sơ đăng ký.</div>
            </div>
            <a asp-controller="Register" asp-action="Index" class="btn btn-light rounded-pill fw-bold"><i class="bi bi-arrow-left"></i> Quay lại thông tin đăng ký</a>
        </div>
    </header>

    <main class="container my-4">
        <div class="card card-room mb-4">
            <div class="card-body">
                <form method="get" class="row g-3 align-items-end">
                    <div class="col-lg-5">
                        <label class="form-label fw-bold">Tìm kiếm</label>
                        <input type="text" name="keyword" value="@keyword" class="form-control" placeholder="Nhập mã phòng, loại phòng, tên tòa..." />
                    </div>
                    <div class="col-lg-3">
                        <label class="form-label fw-bold">Tòa nhà</label>
                        <select name="buildingId" class="form-select" asp-items="ViewBag.Buildings">
                            <option value="">-- Tất cả tòa --</option>
                        </select>
                    </div>
                    <div class="col-lg-2">
                        <div class="form-check mb-2">
                            <input class="form-check-input" type="checkbox" name="onlyAvailable" value="true" @(onlyAvailable ? "checked" : "") id="onlyAvailable" />
                            <label class="form-check-label fw-bold" for="onlyAvailable">Chỉ còn slot</label>
                        </div>
                    </div>
                    <div class="col-lg-2 d-grid">
                        <button class="btn btn-primary fw-bold"><i class="bi bi-search"></i> Lọc</button>
                    </div>
                </form>
            </div>
        </div>

        <div class="card card-room">
            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead>
                            <tr>
                                <th class="ps-4">Tòa nhà</th>
                                <th>Mã phòng</th>
                                <th>Loại phòng</th>
                                <th>Tầng</th>
                                <th>Số lượng</th>
                                <th>Slot còn trống</th>
                                <th>Giá phòng</th>
                                <th>Trạng thái</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (Model == null || !Model.Any())
                            {
                                <tr><td colspan="8" class="text-center text-muted py-5"><i class="bi bi-inbox"></i> Không tìm thấy phòng phù hợp.</td></tr>
                            }
                            else
                            {
                                foreach (var item in Model)
                                {
                                    var available = Math.Max(item.MaxOccupancy - item.CurrentOccupancy, 0);
                                    var isAvailable = item.Status != "Bảo trì" && available > 0;
                                    <tr>
                                        <td class="ps-4"><strong>@(item.Building?.Name ?? "Chưa có tòa")</strong><br /><span class="small text-muted">@(item.Building?.Code ?? "")</span></td>
                                        <td><span class="badge bg-primary-subtle text-primary fw-bold">@item.ApartmentCode</span></td>
                                        <td>@item.ApartmentType</td>
                                        <td>@(item.Floor?.ToString() ?? "-")</td>
                                        <td>@item.CurrentOccupancy / @item.MaxOccupancy</td>
                                        <td><span class="badge slot-badge @(isAvailable ? "bg-success-subtle text-success" : "bg-secondary-subtle text-secondary")">@available slot</span></td>
                                        <td>@item.RoomPrice.ToString("N0") đ</td>
                                        <td>
                                            @if (isAvailable)
                                            {
                                                <span class="badge bg-success-subtle text-success">Còn chỗ</span>
                                            }
                                            else if (item.Status == "Bảo trì")
                                            {
                                                <span class="badge bg-warning-subtle text-warning">Bảo trì</span>
                                            }
                                            else
                                            {
                                                <span class="badge bg-danger-subtle text-danger">Đã đầy</span>
                                            }
                                        </td>
                                    </tr>
                                }
                            }
                        </tbody>
                    </table>
                </div>
            </div>
            <div class="card-footer bg-white d-flex justify-content-between align-items-center flex-wrap gap-2">
                <small class="text-muted">Đang hiển thị @(Model?.Count ?? 0) phòng.</small>
                <a asp-controller="Register" asp-action="Start" class="btn btn-primary rounded-pill fw-bold">Tiến hành đăng ký cư trú <i class="bi bi-arrow-right"></i></a>
            </div>
        </div>
    </main>
</body>
</html>

@{
    var path = Context.Request.Path.ToString().ToLower();
    var controller = ViewContext.RouteData.Values["controller"]?.ToString() ?? "";
    var isApprovalOpen = path.Contains("/admin/approval") || path.Contains("/admin/registrationrequest") || path.Contains("/admin/formrequest") || path.Contains("/admin/vehicleapproval");
}
<!doctype html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <title>@ViewData["Title"] - KTX HUTECH Admin</title>
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="stylesheet" href="~/adminlte/css/adminlte.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.13.1/font/bootstrap-icons.min.css" />
    <style>
        .app-sidebar .nav-header{padding:1.2rem 1.3rem .45rem;font-size:.7rem;font-weight:800;color:rgba(255,255,255,.42);letter-spacing:1.5px;}
        .app-sidebar .nav-link{border-radius:12px;margin:4px 10px;padding:11px 14px;color:rgba(255,255,255,.74)!important;display:flex;align-items:center;gap:10px;}
        .app-sidebar .nav-link:hover{background:rgba(255,255,255,.07);color:#fff!important;}
        .app-sidebar .nav-link.active{background:linear-gradient(135deg,#0f4c81,#1a73e8);color:#fff!important;font-weight:700;box-shadow:0 8px 18px rgba(26,115,232,.22);}
        .app-sidebar .nav-icon{width:22px;text-align:center;font-size:1.05rem;}
        .brand-logo-hutech{width:38px;height:38px;object-fit:contain;border-radius:9px;background:#fff;padding:3px;}
        .navbar-glass{background:rgba(255,255,255,.95)!important;backdrop-filter:blur(10px);border-bottom:1px solid #e2e8f0;}
        .avatar-circle{width:34px;height:34px;border-radius:50%;background:linear-gradient(135deg,#0f4c81,#1a73e8);color:#fff;display:flex;align-items:center;justify-content:center;font-weight:800;}
        .admin-footer{background:#fff;border-top:1px solid #e2e8f0;padding:14px 22px;color:#64748b;font-size:.85rem;}
        .app-main{background:#f4f7fb;min-height:100vh;}
        .app-content{padding:24px!important;}
        .card{border:1px solid #e5edf5!important;border-radius:16px!important;box-shadow:0 12px 28px rgba(15,23,42,.06)!important;}
        .card-header{border-radius:16px 16px 0 0!important;}
        .form-control,.form-select{border-color:#d9e4ef;border-radius:12px;}
        .form-control:focus,.form-select:focus{border-color:#1a73e8;box-shadow:0 0 0 .2rem rgba(26,115,232,.12);}
        .btn{font-weight:700;border-radius:12px;}
        .table{--bs-table-hover-bg:#f8fbff;}
        .table thead th{border-bottom:1px solid #e2e8f0!important;}
        .alert{border-radius:14px;border:0;}
        .badge{font-weight:700;}
    </style>
</head>
<body class="layout-fixed sidebar-expand-lg bg-body-tertiary">
<div class="app-wrapper">
    <nav class="app-header navbar navbar-expand navbar-glass">
        <div class="container-fluid">
            <ul class="navbar-nav">
                <li class="nav-item"><a class="nav-link" data-lte-toggle="sidebar" href="#" role="button"><i class="bi bi-list"></i></a></li>
                <li class="nav-item d-none d-md-block"><a class="nav-link fw-bold text-primary" asp-area="Admin" asp-controller="Dashboard" asp-action="Index">KTX HUTECH <span class="badge bg-secondary">SYSTEM</span></a></li>
            </ul>
            <div class="d-flex align-items-center gap-3">
                <div class="avatar-circle">A</div>
                <div class="d-none d-md-block"><div class="fw-bold">Quản trị viên</div><small class="text-muted">Admin Panel</small></div>
                <form asp-area="" asp-controller="Auth" asp-action="Logout" method="post" class="ms-2">
                    <button class="btn btn-link text-danger text-decoration-none"><i class="bi bi-box-arrow-right"></i> Đăng xuất</button>
                </form>
            </div>
        </div>
    </nav>

    <aside class="app-sidebar bg-dark shadow" data-bs-theme="dark">
        <div class="sidebar-brand">
            <a asp-area="Admin" asp-controller="Dashboard" asp-action="Index" class="brand-link text-decoration-none d-flex align-items-center justify-content-center gap-2 py-3">
                <img src="~/images/logohutech.jpg" class="brand-logo-hutech" alt="Logo" />
                <span class="brand-text fw-bold">KTX <span class="text-info">HUTECH</span><small class="d-block text-center text-white-50" style="letter-spacing:3px;font-size:.62rem">ADMIN</small></span>
            </a>
        </div>
        <div class="sidebar-wrapper">
            <nav class="mt-2">
                <ul class="nav sidebar-menu flex-column" data-lte-toggle="treeview" role="navigation" data-accordion="false">
                    <li class="nav-header">QUẢN LÝ HỆ THỐNG</li>
                    <li class="nav-item"><a asp-area="Admin" asp-controller="Dashboard" asp-action="Index" class="nav-link @(path.Contains("/admin/dashboard") || path == "/admin" ? "active" : "")"><i class="nav-icon bi bi-grid-1x2-fill"></i><p>Bảng điều khiển</p></a></li>

                    <li class="nav-header">XÉT DUYỆT</li>
                    <li class="nav-item @(isApprovalOpen ? "menu-open" : "")">
                        <a href="#" class="nav-link @(isApprovalOpen ? "active" : "")"><i class="nav-icon bi bi-hourglass-split"></i><p>Chờ duyệt <i class="nav-arrow bi bi-chevron-right"></i></p></a>
                        <ul class="nav nav-treeview">
                            <li class="nav-item"><a asp-area="Admin" asp-controller="Approval" asp-action="Index" class="nav-link @(path.Contains("/admin/approval") ? "active" : "")"><i class="nav-icon bi bi-speedometer2"></i><p>Tổng quan chờ duyệt</p></a></li>
                            <li class="nav-item"><a asp-area="Admin" asp-controller="RegistrationRequest" asp-action="Index" class="nav-link @(path.Contains("/admin/registrationrequest") ? "active" : "")"><i class="nav-icon bi bi-person-check-fill"></i><p>Duyệt hồ sơ sinh viên</p></a></li>
                            <li class="nav-item"><a asp-area="Admin" asp-controller="FormRequest" asp-action="Index" class="nav-link @(path.Contains("/admin/formrequest") ? "active" : "")"><i class="nav-icon bi bi-card-checklist"></i><p>Duyệt biểu mẫu</p></a></li>
                            <li class="nav-item"><a asp-area="Admin" asp-controller="VehicleApproval" asp-action="Index" class="nav-link @(path.Contains("/admin/vehicleapproval") ? "active" : "")"><i class="nav-icon bi bi-car-front-fill"></i><p>Duyệt biển số xe</p></a></li>
                        </ul>
                    </li>

                    <li class="nav-header">QUẢN LÝ DANH MỤC</li>
                    <li class="nav-item"><a asp-area="Admin" asp-controller="Resident" asp-action="Index" class="nav-link @(controller == "Resident" ? "active" : "")"><i class="nav-icon bi bi-people-fill"></i><p>Sinh viên đã duyệt</p></a></li>
                    <li class="nav-item"><a asp-area="Admin" asp-controller="Building" asp-action="Index" class="nav-link @(controller == "Building" ? "active" : "")"><i class="nav-icon bi bi-building-fill"></i><p>Tòa nhà KTX</p></a></li>
                    <li class="nav-item"><a asp-area="Admin" asp-controller="Room" asp-action="Index" class="nav-link @(controller == "Room" ? "active" : "")"><i class="nav-icon bi bi-door-open-fill"></i><p>Phòng KTX</p></a></li>
                    <li class="nav-item"><a asp-area="Admin" asp-controller="ResidentCard" asp-action="Index" class="nav-link @(controller == "ResidentCard" ? "active" : "")"><i class="nav-icon bi bi-person-badge-fill"></i><p>Thẻ KTX</p></a></li>
                    <li class="nav-item"><a asp-area="Admin" asp-controller="Vehicle" asp-action="Index" class="nav-link @(controller == "Vehicle" ? "active" : "")"><i class="nav-icon bi bi-scooter"></i><p>Đăng ký biển số xe</p></a></li>
                    <li class="nav-item"><a asp-area="Admin" asp-controller="FormTemplate" asp-action="Index" class="nav-link @(controller == "FormTemplate" ? "active" : "")"><i class="nav-icon bi bi-journal-plus"></i><p>Quản lý biểu mẫu</p></a></li>
                    <li class="nav-item"><a asp-area="Admin" asp-controller="Notification" asp-action="Index" class="nav-link @(controller == "Notification" ? "active" : "")"><i class="nav-icon bi bi-megaphone-fill"></i><p>Thông báo</p></a></li>

                    <li class="nav-header">DỊCH VỤ & TÀI CHÍNH</li>
                    <li class="nav-item"><a asp-area="Admin" asp-controller="Service" asp-action="Index" class="nav-link @(controller == "Service" ? "active" : "")"><i class="nav-icon bi bi-layers-half"></i><p>Danh mục dịch vụ</p></a></li>
                    <li class="nav-item"><a asp-area="Admin" asp-controller="ServiceBooking" asp-action="Index" class="nav-link @(controller == "ServiceBooking" ? "active" : "")"><i class="nav-icon bi bi-calendar-check-fill"></i><p>Yêu cầu dịch vụ</p></a></li>
                    <li class="nav-item"><a asp-area="Admin" asp-controller="Invoice" asp-action="Index" class="nav-link @(controller == "Invoice" ? "active" : "")"><i class="nav-icon bi bi-receipt-cutoff"></i><p>Hóa đơn</p></a></li>
                    <li class="nav-item"><a asp-area="Admin" asp-controller="Payment" asp-action="Index" class="nav-link @(controller == "Payment" ? "active" : "")"><i class="nav-icon bi bi-credit-card-fill"></i><p>Thanh toán</p></a></li>
                </ul>
            </nav>
        </div>
    </aside>

    <main class="app-main">
        <div class="app-content p-3">
            @RenderBody()
        </div>
    </main>
    <footer class="app-footer admin-footer"><strong>© @DateTime.Now.Year KTX HUTECH</strong> | Hệ thống quản lý cư trú sinh viên ký túc xá</footer>
</div>
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
<script src="~/adminlte/js/adminlte.js"></script>
@await RenderSectionAsync("Scripts", required: false)
</body>
</html>

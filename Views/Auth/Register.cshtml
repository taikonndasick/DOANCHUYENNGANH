@model QuanLyKTX.ViewModels.RegisterViewModel
@{
    Layout = null;
    ViewData["Title"] = "Đăng ký cư trú KTX";
}
<!doctype html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Đăng ký cư trú KTX</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.7/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.13.1/font/bootstrap-icons.min.css" rel="stylesheet" />
    <style>
        body { background:#f3f7fb; color:#162033; }
        .topbar { background:linear-gradient(90deg,#075aaa,#1677e8); color:#fff; padding:30px 0; }
        .main-card { border:1px solid #dce8f5; border-radius:22px; box-shadow:0 18px 45px rgba(15,76,129,.09); }
        .section-title { font-weight:850; color:#064a8d; border-bottom:1px solid #e5eef7; padding-bottom:10px; margin-bottom:20px; }
        .upload-box { border:1px dashed #99bce6; background:#f8fbff; border-radius:16px; padding:18px; height:100%; }
        .btn-submit { border:0; background:linear-gradient(90deg,#075aaa,#1677e8); color:#fff; padding:14px 26px; border-radius:14px; font-weight:850; width:100%; }
        .form-label { font-weight:700; }
    </style>
</head>
<body>
    <header class="topbar">
        <div class="container d-flex justify-content-between align-items-center gap-3 flex-wrap">
            <div>
                <div class="text-uppercase small fw-bold opacity-75">KTX HUTECH</div>
                <h1 class="fw-black mb-1">Đăng ký cư trú ký túc xá</h1>
                <div class="opacity-75">Sinh viên nhập thông tin, tải hồ sơ và chờ admin duyệt tài khoản.</div>
            </div>
            <a asp-controller="Register" asp-action="Rooms" class="btn btn-light rounded-pill fw-bold"><i class="bi bi-building"></i> Xem phòng còn trống</a>
        </div>
    </header>

    <main class="container my-5">
        <div class="main-card bg-white p-4 p-lg-5">
            <form asp-action="Register" asp-controller="Auth" method="post" enctype="multipart/form-data">
                @Html.AntiForgeryToken()
                <input asp-for="ReturnUrl" type="hidden" />
                <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>

                <h4 class="section-title"><i class="bi bi-person-vcard me-2"></i>Thông tin sinh viên</h4>
                <div class="row g-3 mb-4">
                    <div class="col-md-4"><label asp-for="StudentCode" class="form-label"></label><input asp-for="StudentCode" class="form-control" maxlength="10" inputmode="numeric" pattern="[0-9]{10}" placeholder="VD: 2380600000" /><span asp-validation-for="StudentCode" class="text-danger"></span></div>
                    <div class="col-md-8"><label asp-for="FullName" class="form-label"></label><input asp-for="FullName" class="form-control" /><span asp-validation-for="FullName" class="text-danger"></span></div>
                    <div class="col-md-4"><label asp-for="DateOfBirth" class="form-label"></label><input asp-for="DateOfBirth" class="form-control" type="date" /><span asp-validation-for="DateOfBirth" class="text-danger"></span></div>
                    <div class="col-md-4"><label asp-for="Gender" class="form-label"></label><select asp-for="Gender" class="form-select"><option value="">-- Chọn giới tính --</option><option>Nam</option><option>Nữ</option><option>Khác</option></select><span asp-validation-for="Gender" class="text-danger"></span></div>
                    <div class="col-md-4"><label asp-for="NationalId" class="form-label"></label><input asp-for="NationalId" class="form-control" /><span asp-validation-for="NationalId" class="text-danger"></span></div>
                    <div class="col-md-4"><label asp-for="PhoneNumber" class="form-label"></label><input asp-for="PhoneNumber" class="form-control" maxlength="10" inputmode="numeric" pattern="0[0-9]{9}" placeholder="VD: 0901234567" /><span asp-validation-for="PhoneNumber" class="text-danger"></span></div>
                    <div class="col-md-8"><label asp-for="Email" class="form-label"></label><input asp-for="Email" class="form-control" /><span asp-validation-for="Email" class="text-danger"></span></div>
                    <div class="col-md-12"><label asp-for="Address" class="form-label"></label><input asp-for="Address" class="form-control" /><span asp-validation-for="Address" class="text-danger"></span></div>
                    <div class="col-md-6"><label asp-for="ClassName" class="form-label"></label><input asp-for="ClassName" class="form-control" /><span asp-validation-for="ClassName" class="text-danger"></span></div>
                    <div class="col-md-6"><label asp-for="Faculty" class="form-label"></label><input asp-for="Faculty" class="form-control" /><span asp-validation-for="Faculty" class="text-danger"></span></div>
                </div>

                <h4 class="section-title"><i class="bi bi-person-lock me-2"></i>Thông tin tài khoản</h4>
                <div class="row g-3 mb-4">
                    <div class="col-md-4"><label asp-for="Username" class="form-label"></label><input asp-for="Username" class="form-control" /><span asp-validation-for="Username" class="text-danger"></span></div>
                    <div class="col-md-4"><label asp-for="Password" class="form-label"></label><input asp-for="Password" class="form-control" /><span asp-validation-for="Password" class="text-danger"></span></div>
                    <div class="col-md-4"><label asp-for="ConfirmPassword" class="form-label"></label><input asp-for="ConfirmPassword" class="form-control" /><span asp-validation-for="ConfirmPassword" class="text-danger"></span></div>
                </div>

                <h4 class="section-title"><i class="bi bi-bank me-2"></i>Thông tin ngân hàng</h4>
                <div class="row g-3 mb-4">
                    <div class="col-md-6"><label asp-for="BankAccountNumber" class="form-label"></label><input asp-for="BankAccountNumber" class="form-control" /><span asp-validation-for="BankAccountNumber" class="text-danger"></span></div>
                    <div class="col-md-6"><label asp-for="BankName" class="form-label"></label><input asp-for="BankName" class="form-control" placeholder="VD: Vietcombank, BIDV, Agribank..." /><span asp-validation-for="BankName" class="text-danger"></span></div>
                </div>

                <h4 class="section-title"><i class="bi bi-cloud-upload me-2"></i>Giấy tờ bắt buộc</h4>
                <div class="row g-3 mb-4">
                    <div class="col-md-6 col-lg-3"><div class="upload-box"><label asp-for="CitizenIdFile" class="form-label"></label><input asp-for="CitizenIdFile" class="form-control" type="file" accept=".jpg,.jpeg,.png,.pdf" /><div class="small text-muted mt-2">Ảnh/PDF căn cước. Tối đa 5MB.</div><span asp-validation-for="CitizenIdFile" class="text-danger"></span></div></div>
                    <div class="col-md-6 col-lg-3"><div class="upload-box"><label asp-for="HealthInsuranceFile" class="form-label"></label><input asp-for="HealthInsuranceFile" class="form-control" type="file" accept=".jpg,.jpeg,.png,.pdf" /><div class="small text-muted mt-2">Ảnh/PDF thẻ bảo hiểm y tế.</div><span asp-validation-for="HealthInsuranceFile" class="text-danger"></span></div></div>
                    <div class="col-md-6 col-lg-3"><div class="upload-box"><label asp-for="AdmissionProofFile" class="form-label"></label><input asp-for="AdmissionProofFile" class="form-control" type="file" accept=".jpg,.jpeg,.png,.pdf" /><div class="small text-muted mt-2">Giấy trúng tuyển, xác nhận nhập học hoặc thẻ sinh viên.</div><span asp-validation-for="AdmissionProofFile" class="text-danger"></span></div></div>
                    <div class="col-md-6 col-lg-3"><div class="upload-box"><label asp-for="PortraitPhotoFile" class="form-label"></label><input asp-for="PortraitPhotoFile" class="form-control" type="file" accept=".jpg,.jpeg,.png" /><div class="small text-muted mt-2">Ảnh rõ mặt, nền sáng, dùng cho hồ sơ và thẻ KTX.</div><span asp-validation-for="PortraitPhotoFile" class="text-danger"></span></div></div>
                </div>

                <button type="submit" class="btn-submit">Gửi hồ sơ đăng ký và chờ admin duyệt <i class="bi bi-send ms-1"></i></button>

                <div class="text-center mt-4">
                    <a asp-controller="Register" asp-action="Index" class="text-muted text-decoration-none me-3"><i class="bi bi-arrow-left"></i> Quay lại trang thông tin</a>
                    <a asp-controller="Auth" asp-action="Login" class="text-decoration-none fw-semibold">Đã có tài khoản? Đăng nhập</a>
                </div>
            </form>
        </div>
    </main>

    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <partial name="_ValidationScriptsPartial" />
</body>
</html>

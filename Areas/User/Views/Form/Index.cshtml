@{
    ViewData["Title"] = "Biểu mẫu";
    Layout = "_UserLayout";
}

<div class="card page-card p-4">
    <h3 class="page-title mb-1"><i class="bi bi-journal-text text-primary me-2"></i>Biểu mẫu</h3>
    <p class="text-muted">Chọn nhóm biểu mẫu bạn muốn sử dụng.</p>
    <div class="row g-3 mt-2">
        <div class="col-md-6">
            <a asp-action="Templates" class="text-decoration-none">
                <div class="border rounded-4 p-4 h-100 bg-white shadow-sm">
                    <i class="bi bi-list-check text-primary fs-1"></i>
                    <h4 class="fw-bold mt-3 text-dark">Danh sách biểu mẫu</h4>
                    <p class="text-muted mb-0">Xem các mẫu đơn có sẵn và điền biểu mẫu trực tuyến.</p>
                </div>
            </a>
        </div>
        <div class="col-md-6">
            <a asp-action="Submitted" class="text-decoration-none">
                <div class="border rounded-4 p-4 h-100 bg-white shadow-sm">
                    <i class="bi bi-archive text-primary fs-1"></i>
                    <h4 class="fw-bold mt-3 text-dark">Biểu mẫu đã điền</h4>
                    <p class="text-muted mb-0">Theo dõi trạng thái các biểu mẫu đã gửi cho ban quản lý.</p>
                </div>
            </a>
        </div>
    </div>
</div>

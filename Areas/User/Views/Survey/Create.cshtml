@{ ViewData["Title"] = "Gửi khảo sát"; Layout = "_UserLayout"; }
<div class="card page-card p-4 mx-auto" style="max-width:760px"><h3 class="page-title mb-3">Gửi khảo sát</h3><form method="post" class="row g-3">@Html.AntiForgeryToken()<div class="col-md-8"><label class="form-label fw-bold">Nội dung khảo sát</label><input name="surveyTitle" value="Khảo sát mức độ hài lòng" class="form-control rounded-3" /></div><div class="col-md-4"><label class="form-label fw-bold">Mức hài lòng</label><select name="satisfactionLevel" class="form-select rounded-3"><option value="5">5 - Rất hài lòng</option><option value="4">4 - Hài lòng</option><option value="3">3 - Bình thường</option><option value="2">2 - Chưa hài lòng</option><option value="1">1 - Không hài lòng</option></select></div><div class="col-12"><label class="form-label fw-bold">Góp ý</label><textarea name="feedback" rows="5" class="form-control rounded-3"></textarea></div><div class="col-12"><button class="btn btn-primary rounded-pill px-4">Gửi khảo sát</button><a asp-action="Index" class="btn btn-link text-muted">Quay lại</a></div></form></div>

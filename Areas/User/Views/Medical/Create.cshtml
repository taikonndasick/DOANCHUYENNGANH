@{ ViewData["Title"] = "Đăng ký khám chữa bệnh"; Layout = "_UserLayout"; }
<div class="card page-card p-4 mx-auto" style="max-width:760px"><h3 class="page-title mb-3">Đăng ký khám chữa bệnh</h3><form method="post" class="row g-3">@Html.AntiForgeryToken()<div class="col-md-6"><label class="form-label fw-bold">Loại đăng ký</label><select name="registrationType" class="form-select rounded-3"><option>Khám sức khỏe</option><option>Khám định kỳ</option><option>Tư vấn y tế</option><option>Hỗ trợ y tế</option></select></div><div class="col-md-6"><label class="form-label fw-bold">Ngày mong muốn</label><input type="date" name="preferredDate" class="form-control rounded-3" /></div><div class="col-12"><label class="form-label fw-bold">Triệu chứng / ghi chú</label><textarea name="note" rows="4" class="form-control rounded-3"></textarea></div><div class="col-12"><button class="btn btn-primary rounded-pill px-4">Gửi đăng ký</button><a asp-action="Index" class="btn btn-link text-muted">Quay lại</a></div></form></div>

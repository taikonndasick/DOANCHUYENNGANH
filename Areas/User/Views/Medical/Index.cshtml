@model IEnumerable<QuanLyKTX.Models.MedicalRegistration>
@{ ViewData["Title"] = "ĐK khám chữa bệnh"; Layout = "_UserLayout"; }
<div class="card page-card p-4">
    <div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-2"><div><h3 class="page-title mb-1"><i class="bi bi-hospital text-primary me-2"></i>Đăng ký khám chữa bệnh</h3><p class="text-muted mb-0">Gửi đăng ký khám sức khỏe, khám định kỳ hoặc hỗ trợ y tế.</p></div><a asp-action="Create" class="btn btn-primary rounded-pill"><i class="bi bi-plus-circle"></i> Đăng ký mới</a></div>
    @if (TempData["Success"] != null) { <div class="alert alert-success rounded-4">@TempData["Success"]</div> }
    @if (TempData["Error"] != null) { <div class="alert alert-warning rounded-4">@TempData["Error"]</div> }
    <div class="table-responsive"><table class="table align-middle table-hover"><thead class="table-light"><tr><th>Ngày gửi</th><th>Loại đăng ký</th><th>Ngày mong muốn</th><th>Ghi chú</th><th>Trạng thái</th></tr></thead><tbody>
    @foreach(var item in Model){<tr><td>@item.CreatedAt.ToString("dd/MM/yyyy HH:mm")</td><td class="fw-semibold">@item.RegistrationType</td><td>@(item.PreferredDate?.ToString("dd/MM/yyyy") ?? "-")</td><td>@item.Note</td><td><span class="badge bg-warning text-dark rounded-pill px-3 py-2">@item.Status</span></td></tr>}
    @if(!Model.Any()){<tr><td colspan="5" class="empty-state">Chưa có đăng ký khám chữa bệnh.</td></tr>}
    </tbody></table></div>
</div>

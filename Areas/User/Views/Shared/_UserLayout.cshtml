@{
    var controller = ViewContext.RouteData.Values["controller"]?.ToString() ?? "";
    var action = ViewContext.RouteData.Values["action"]?.ToString() ?? "";
    string active(string name) => controller.Equals(name, StringComparison.OrdinalIgnoreCase) ? "active" : "";
}
<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - KTX HUTECH Student</title>
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css" />
    <style>
        :root{--user-primary:#0f4c81;--user-gradient:linear-gradient(135deg,#0f4c81 0%,#1a73e8 100%);--user-bg:#f1f5f9;--nav-height:72px;}
        body{font-family:'Plus Jakarta Sans',sans-serif;background-color:var(--user-bg);color:#1e293b;}
        .navbar-user{min-height:var(--nav-height);background:rgba(255,255,255,.95)!important;backdrop-filter:blur(10px);border-bottom:1px solid #e2e8f0;box-shadow:0 4px 12px rgba(15,76,129,.05);z-index:1030;}
        .navbar-brand{font-weight:800;color:var(--user-primary)!important;}.brand-subtext{color:#1a73e8;font-weight:400;letter-spacing:1px;font-size:.9rem;}
        .nav-link{font-weight:700;color:#64748b;padding:.55rem .85rem!important;border-radius:12px;margin:2px;font-size:.9rem;white-space:nowrap;}
        .nav-link:hover{color:var(--user-primary);background:rgba(15,76,129,.06);}.nav-link.active{color:#fff!important;background:var(--user-gradient);box-shadow:0 4px 10px rgba(15,76,129,.2);}
        .user-avatar{width:36px;height:36px;background:var(--user-gradient);color:#fff;border-radius:10px;display:flex;align-items:center;justify-content:center;font-weight:800;font-size:14px;box-shadow:0 4px 8px rgba(15,76,129,.2);}
        .dropdown-menu{border:1px solid #e2e8f0;box-shadow:0 10px 25px rgba(0,0,0,.1);border-radius:15px;padding:10px;}.dropdown-item{border-radius:10px;padding:8px 15px;font-weight:600;}
        .main-content{padding-top:32px;padding-bottom:60px;min-height:calc(100vh - var(--nav-height) - 80px);}.user-footer{background:#fff!important;padding:22px 0;border-top:1px solid #e2e8f0;font-size:.85rem;color:#64748b;}.footer-brand{font-weight:800;color:#0f4c81;}.btn-logout-user{color:#e11d48!important;}
        .page-card{background:#fff;border:1px solid #e5edf5;border-radius:20px;box-shadow:0 12px 30px rgba(15,76,129,.08);}.page-title{font-weight:800;color:#0f172a;}.empty-state{padding:48px 20px;text-align:center;color:#94a3b8;}
        .card{border:1px solid #e5edf5;border-radius:18px;box-shadow:0 12px 30px rgba(15,23,42,.06);}
        .form-control,.form-select{border-color:#d9e4ef;border-radius:12px;}
        .form-control:focus,.form-select:focus{border-color:#1a73e8;box-shadow:0 0 0 .2rem rgba(26,115,232,.12);}
        .btn{font-weight:700;border-radius:12px;}
        .table{--bs-table-hover-bg:#f8fbff;}
        .table thead th{border-bottom:1px solid #e2e8f0;color:#475569;font-size:.75rem;text-transform:uppercase;}
        .alert{border:0;border-radius:14px;}
        .badge{font-weight:700;}
    </style>
</head>
<body>
<nav class="navbar navbar-expand-xl navbar-user sticky-top">
    <div class="container-fluid px-lg-5">
        <a class="navbar-brand d-flex align-items-center" asp-area="User" asp-controller="Dashboard" asp-action="Index"><i class="bi bi-buildings-fill me-2 fs-3"></i><span>KTX <span class="brand-subtext">HUTECH</span></span></a>
        <button class="navbar-toggler border-0" type="button" data-bs-toggle="collapse" data-bs-target="#userNavbar"><i class="bi bi-list fs-2" style="color:var(--user-primary);"></i></button>
        <div class="collapse navbar-collapse" id="userNavbar">
            <ul class="navbar-nav mx-auto mb-2 mb-xl-0 flex-wrap">
                <li class="nav-item"><a class="nav-link @active("Dashboard")" asp-area="User" asp-controller="Dashboard" asp-action="Index"><i class="bi bi-house-door me-1"></i>Trang chủ</a></li>
                <li class="nav-item"><a class="nav-link @(controller=="Profile" && action!="Residence" ? "active" : "")" asp-area="User" asp-controller="Profile" asp-action="Index"><i class="bi bi-person-vcard me-1"></i>Thông tin sinh viên</a></li>
                <li class="nav-item"><a class="nav-link @(controller=="Profile" && action=="Residence" ? "active" : "")" asp-area="User" asp-controller="Profile" asp-action="Residence"><i class="bi bi-house-check me-1"></i>Thông tin lưu trú</a></li>
                <li class="nav-item"><a class="nav-link @active("Vehicle")" asp-area="User" asp-controller="Vehicle" asp-action="Index"><i class="bi bi-scooter me-1"></i>Đăng ký biển số</a></li>
                <li class="nav-item"><a class="nav-link @active("Medical")" asp-area="User" asp-controller="Medical" asp-action="Index"><i class="bi bi-hospital me-1"></i>ĐK khám chữa bệnh</a></li>
                <li class="nav-item"><a class="nav-link @active("Invoice")" asp-area="User" asp-controller="Invoice" asp-action="Index"><i class="bi bi-receipt me-1"></i>Hóa đơn, biên lai</a></li>
                <li class="nav-item"><a class="nav-link @active("Service")" asp-area="User" asp-controller="Service" asp-action="Index"><i class="bi bi-tools me-1"></i>Dịch vụ</a></li>
                <li class="nav-item dropdown">
                    <a class="nav-link dropdown-toggle @(controller=="Request"||controller=="HealthInsurance" ? "active" : "")" href="#" data-bs-toggle="dropdown"><i class="bi bi-card-checklist me-1"></i>Yêu cầu</a>
                    <ul class="dropdown-menu">
                        <li><a class="dropdown-item" asp-area="User" asp-controller="Request" asp-action="Checkout"><i class="bi bi-box-arrow-left me-2"></i>Yêu cầu trả phòng</a></li>
                        <li><a class="dropdown-item" asp-area="User" asp-controller="HealthInsurance" asp-action="Index"><i class="bi bi-file-earmark-medical me-2"></i>Khai báo BHYT</a></li>
                    </ul>
                </li>
                <li class="nav-item dropdown">
                    <a class="nav-link dropdown-toggle @active("Form")" href="#" data-bs-toggle="dropdown"><i class="bi bi-journal-text me-1"></i>Biểu mẫu</a>
                    <ul class="dropdown-menu">
                        <li><a class="dropdown-item" asp-area="User" asp-controller="Form" asp-action="Templates"><i class="bi bi-list-check me-2"></i>Danh sách biểu mẫu</a></li>
                        <li><a class="dropdown-item" asp-area="User" asp-controller="Form" asp-action="Submitted"><i class="bi bi-archive me-2"></i>Biểu mẫu đã điền</a></li>
                    </ul>
                </li>
                <li class="nav-item"><a class="nav-link @active("Survey")" asp-area="User" asp-controller="Survey" asp-action="Index"><i class="bi bi-clipboard-data me-1"></i>Khảo sát</a></li>
                <li class="nav-item"><a class="nav-link @active("Notification")" asp-area="User" asp-controller="Notification" asp-action="Index"><i class="bi bi-megaphone me-1"></i>Thông báo</a></li>
            </ul>
            <div class="dropdown">
                <a href="#" class="d-flex align-items-center text-decoration-none dropdown-toggle text-dark fw-bold" data-bs-toggle="dropdown">
                    <div class="user-avatar me-2">@(User.Identity?.Name?.Substring(0,1).ToUpper() ?? "U")</div><span class="d-none d-sm-inline" style="color:var(--user-primary);">@User.Identity?.Name</span>
                </a>
                <ul class="dropdown-menu dropdown-menu-end shadow border-0 p-2 mt-2">
                    <li><a class="dropdown-item" asp-area="User" asp-controller="Profile" asp-action="Index"><i class="bi bi-person me-2"></i>Hồ sơ sinh viên</a></li>
                    <li><a class="dropdown-item" asp-area="User" asp-controller="Profile" asp-action="Settings"><i class="bi bi-gear me-2"></i>Cài đặt</a></li>
                    <li><hr class="dropdown-divider"></li>
                    <li><form asp-area="" asp-controller="Auth" asp-action="Logout" method="post"><button type="submit" class="dropdown-item btn-logout-user"><i class="bi bi-box-arrow-right me-2"></i>Đăng xuất</button></form></li>
                </ul>
            </div>
        </div>
    </div>
</nav>
<main class="container-fluid px-lg-5 main-content">@RenderBody()</main>
<footer class="user-footer text-center mt-auto"><div class="container"><span class="footer-brand">KTX <span style="color:#1a73e8;">HUTECH</span></span><span class="ms-2 opacity-50">| Cổng thông tin sinh viên</span></div></footer>
<script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/microsoft-signalr/6.0.1/signalr.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
<script>
    try {
        const connection = new signalR.HubConnectionBuilder().withUrl("/notificationHub").build();
        connection.on("ReceiveNotification", function (title, content) {
            Swal.fire({title:`<span style="color:#0f4c81;"><i class="bi bi-megaphone"></i> ${title}</span>`, text:content, icon:'info', confirmButtonColor:'#0f4c81', toast:true, position:'top-end', timer:10000, timerProgressBar:true, showCloseButton:true});
        });
        connection.start().catch(function(){ });
    } catch { }
</script>
@await RenderSectionAsync("Scripts", required: false)
</body>
</html>

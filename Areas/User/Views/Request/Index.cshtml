@model IEnumerable<QuanLyKTX.Models.StudentRequestForm>
@{ ViewData["Title"] = "Yêu cầu"; Layout = "_UserLayout"; }
<div class="card page-card p-4">
    <div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-2"><div><h3 class="page-title mb-1"><i class="bi bi-card-checklist text-primary me-2"></i>Yêu cầu sinh viên</h3><p class="text-muted mb-0">Theo dõi yêu cầu trả phòng và các yêu cầu liên quan.</p></div><a asp-action="Checkout" class="btn btn-primary rounded-pill"><i class="bi bi-box-arrow-left"></i> Yêu cầu trả phòng</a></div>
    @if (TempData["Success"] != null) { <div class="alert alert-success rounded-4">@TempData["Success"]</div> }
    @if (TempData["Error"] != null) { <div class="alert alert-warning rounded-4">@TempData["Error"]</div> }
    <div class="table-responsive"><table class="table align-middle table-hover"><thead class="table-light"><tr><th>Ngày gửi</th><th>Loại</th><th>Tiêu đề</th><th>Trạng thái</th></tr></thead><tbody>
    @foreach(var item in Model){<tr><td>@item.CreatedAt.ToString("dd/MM/yyyy HH:mm")</td><td>@item.FormType</td><td>@item.Title</td><td><span class="badge bg-warning text-dark rounded-pill px-3 py-2">@item.Status</span></td></tr>}
    @if(!Model.Any()){<tr><td colspan="4" class="empty-state">Chưa có yêu cầu nào.</td></tr>}
    </tbody></table></div>
</div>

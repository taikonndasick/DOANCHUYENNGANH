@{ ViewData["Title"] = "Yêu cầu trả phòng"; Layout = "_UserLayout"; }
<div class="card page-card p-4 mx-auto" style="max-width:760px">
    <h3 class="page-title mb-1"><i class="bi bi-box-arrow-left text-primary me-2"></i>Yêu cầu trả phòng</h3><p class="text-muted">Yêu cầu sẽ được gửi tới admin để kiểm tra công nợ, tình trạng phòng và xử lý.</p>
    <form method="post" class="row g-3">@Html.AntiForgeryToken()
        <div class="col-md-6"><label class="form-label fw-bold">Ngày trả dự kiến</label><input type="date" name="expectedCheckoutDate" class="form-control rounded-3" /></div>
        <div class="col-12"><label class="form-label fw-bold">Lý do trả phòng</label><textarea name="reason" rows="4" class="form-control rounded-3"></textarea></div>
        <div class="col-12"><label class="form-label fw-bold">Tình trạng phòng hiện tại</label><textarea name="roomCondition" rows="3" class="form-control rounded-3" placeholder="VD: phòng sạch sẽ, thiết bị còn nguyên vẹn..."></textarea></div>
        <div class="col-12"><button class="btn btn-primary rounded-pill px-4">Gửi yêu cầu</button><a asp-action="Index" class="btn btn-link text-muted">Quay lại</a></div>
    </form>
</div>

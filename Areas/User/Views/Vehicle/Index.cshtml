@model IEnumerable<QuanLyKTX.Models.Vehicle>
@{ ViewData["Title"] = "Đăng ký biển số"; Layout = "_UserLayout"; }
<div class="card page-card p-4">
    <div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-2">
        <div>
            <h3 class="page-title mb-1"><i class="bi bi-scooter text-primary me-2"></i>Đăng ký biển số xe</h3>
            <p class="text-muted mb-0">Theo dõi trạng thái đăng ký biển số xe.</p>
        </div>
        <a asp-action="Create" class="btn btn-primary rounded-pill"><i class="bi bi-plus-circle"></i> Gửi đăng ký mới</a>
    </div>

    @if (TempData["Success"] != null) { <div class="alert alert-success rounded-4">@TempData["Success"]</div> }
    @if (TempData["Error"] != null) { <div class="alert alert-warning rounded-4">@TempData["Error"]</div> }

    <div class="table-responsive">
        <table class="table align-middle table-hover">
            <thead class="table-light">
                <tr>
                    <th>Biển số</th>
                    <th>Loại phương tiện</th>
                    <th>Ảnh biển số</th>
                    <th>Trạng thái</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td class="fw-bold text-primary">@item.LicensePlate</td>
                        <td>@item.VehicleType</td>
                        <td>
                            @if (!string.IsNullOrWhiteSpace(item.LicensePlateImagePath))
                            {
                                <a href="@item.LicensePlateImagePath" target="_blank">
                                    <img src="@item.LicensePlateImagePath" alt="Ảnh biển số" style="width:90px;height:56px;object-fit:cover;border-radius:10px;border:1px solid #e5e7eb" />
                                </a>
                            }
                            else
                            {
                                <span class="text-muted">Chưa có</span>
                            }
                        </td>
                        <td><span class="badge rounded-pill @(item.Status=="Active"||item.Status=="Đã duyệt"?"bg-success":"bg-warning text-dark") px-3 py-2">@item.Status</span></td>
                    </tr>
                }
                @if (!Model.Any())
                {
                    <tr><td colspan="4" class="empty-state">Chưa có đăng ký biển số nào.</td></tr>
                }
            </tbody>
        </table>
    </div>
</div>

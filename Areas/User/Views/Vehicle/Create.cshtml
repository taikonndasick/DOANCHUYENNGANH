@{ ViewData["Title"] = "Gửi đăng ký biển số"; Layout = "_UserLayout"; }
<div class="card page-card p-4 mx-auto" style="max-width:760px">
    <h3 class="page-title mb-1"><i class="bi bi-scooter text-primary me-2"></i>Gửi đăng ký biển số xe</h3>
    <p class="text-muted mb-4">Sinh viên nhập biển số và tải lên hình ảnh biển số để admin kiểm tra trước khi duyệt.</p>

    <form method="post" enctype="multipart/form-data" class="row g-3">
        @Html.AntiForgeryToken()
        <div asp-validation-summary="ModelOnly" class="text-danger"></div>

        <div class="col-md-6">
            <label class="form-label fw-bold">Loại phương tiện</label>
            <select name="vehicleType" class="form-select rounded-3">
                <option>Xe máy</option>
                <option>Xe điện</option>
                <option>Ô tô</option>
            </select>
        </div>

        <div class="col-md-6">
            <label class="form-label fw-bold">Biển số xe</label>
            <input name="licensePlate" class="form-control rounded-3" placeholder="VD: 59A1-123.45" />
            <span class="text-danger" data-valmsg-for="licensePlate"></span>
        </div>

        <div class="col-12">
            <label class="form-label fw-bold">Hình ảnh biển số xe</label>
            <input type="file" name="licensePlateImage" class="form-control rounded-3" accept="image/png,image/jpeg,image/webp" required />
            <div class="form-text">Chấp nhận JPG, PNG hoặc WEBP. Ảnh nên rõ biển số để admin dễ kiểm tra.</div>
            <span class="text-danger" data-valmsg-for="licensePlateImage"></span>
        </div>

        <div class="col-12 d-flex gap-2 flex-wrap">
            <button class="btn btn-primary rounded-pill px-4"><i class="bi bi-send me-1"></i>Gửi đăng ký</button>
            <a asp-action="Index" class="btn btn-link text-muted">Quay lại</a>
        </div>
    </form>
</div>

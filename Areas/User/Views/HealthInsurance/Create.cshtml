@{ ViewData["Title"] = "Khai báo BHYT"; Layout = "_UserLayout"; }
<div class="card page-card p-4 mx-auto" style="max-width:760px"><h3 class="page-title mb-3">Khai báo bảo hiểm y tế</h3><form method="post" enctype="multipart/form-data" class="row g-3">@Html.AntiForgeryToken()<div class="col-md-6"><label class="form-label fw-bold">Mã thẻ BHYT</label><input name="insuranceCode" class="form-control rounded-3" /></div><div class="col-md-6"><label class="form-label fw-bold">Nơi đăng ký KCB</label><input name="hospitalName" class="form-control rounded-3" /></div><div class="col-md-6"><label class="form-label fw-bold">Ngày hiệu lực</label><input type="date" name="validFrom" class="form-control rounded-3" /></div><div class="col-md-6"><label class="form-label fw-bold">Ngày hết hạn</label><input type="date" name="validTo" class="form-control rounded-3" /></div><div class="col-12"><label class="form-label fw-bold">Ảnh/file thẻ BHYT</label><input type="file" name="attachment" class="form-control rounded-3" accept=".jpg,.jpeg,.png,.pdf" /></div><div class="col-12"><button class="btn btn-primary rounded-pill px-4">Gửi khai báo</button><a asp-action="Index" class="btn btn-link text-muted">Quay lại</a></div></form></div>

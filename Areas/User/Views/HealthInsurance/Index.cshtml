@model IEnumerable<QuanLyKTX.Models.HealthInsuranceDeclaration>
@{ ViewData["Title"] = "Khai báo BHYT"; Layout = "_UserLayout"; }
<div class="card page-card p-4">
    <div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-2"><div><h3 class="page-title mb-1"><i class="bi bi-file-earmark-medical text-primary me-2"></i>Khai báo BHYT</h3><p class="text-muted mb-0">Khai báo thẻ bảo hiểm y tế phục vụ quản lý sinh viên nội trú.</p></div><a asp-action="Create" class="btn btn-primary rounded-pill"><i class="bi bi-plus-circle"></i> Khai báo mới</a></div>
    @if (TempData["Success"] != null) { <div class="alert alert-success rounded-4">@TempData["Success"]</div> }
    @if (TempData["Error"] != null) { <div class="alert alert-warning rounded-4">@TempData["Error"]</div> }
    <div class="table-responsive"><table class="table align-middle table-hover"><thead class="table-light"><tr><th>Mã BHYT</th><th>Nơi KCB</th><th>Hiệu lực</th><th>Trạng thái</th></tr></thead><tbody>
    @foreach(var item in Model){<tr><td class="fw-bold">@item.InsuranceCode</td><td>@item.HospitalName</td><td>@(item.ValidFrom?.ToString("dd/MM/yyyy") ?? "-") - @(item.ValidTo?.ToString("dd/MM/yyyy") ?? "-")</td><td><span class="badge bg-warning text-dark rounded-pill px-3 py-2">@item.Status</span></td></tr>}
    @if(!Model.Any()){<tr><td colspan="4" class="empty-state">Chưa có khai báo BHYT.</td></tr>}
    </tbody></table></div>
</div>

@model IEnumerable<QuanLyKTX.Models.Vehicle>
@using Microsoft.AspNetCore.Mvc.Rendering
@{
    ViewData["Title"] = "Đăng ký biển số xe";
    Layout = "_AdminLayout";
    var keyword = ViewBag.Keyword as string ?? "";
    var vehicleType = ViewBag.VehicleType as string ?? "Tất cả";
    int? buildingId = ViewBag.BuildingId as int?;
    var currentPage = (int)(ViewBag.CurrentPage ?? 1);
    var totalPages = (int)(ViewBag.TotalPages ?? 1);
    var pageSize = (int)(ViewBag.PageSize ?? 50);
    var totalCount = (int)(ViewBag.TotalCount ?? Model.Count());
    var buildings = ViewBag.Buildings as SelectList;
    var vehicleTypes = ViewBag.VehicleTypes as SelectList;
}

<div class="container-fluid py-3">
    <div class="card border-0 shadow-sm rounded-4">
        <div class="card-body p-4">
            <div class="d-flex justify-content-between align-items-center mb-4">
                <div>
                    <h4 class="fw-bold mb-1"><i class="bi bi-car-front me-2 text-primary"></i>Danh sách biển số đã duyệt</h4>
                    <p class="text-muted mb-0">Tìm kiếm và lọc biển số xe đã được duyệt.</p>
                </div>
                <a asp-action="Create" class="btn btn-primary rounded-3"><i class="bi bi-plus-circle"></i> Thêm biển số</a>
            </div>

            <form method="get" class="row g-2 align-items-end mb-3">
                <div class="col-md-4">
                    <label class="form-label small text-muted">Từ khóa</label>
                    <input name="keyword" value="@keyword" class="form-control rounded-3" placeholder="Biển số, sinh viên, MSSV, SĐT..." />
                </div>
                <div class="col-md-2">
                    <label class="form-label small text-muted">Loại xe</label>
                    <select name="vehicleType" class="form-select rounded-3">
                        <option value="Tất cả">Tất cả</option>
                        @if (vehicleTypes != null)
                        {
                            foreach (var t in vehicleTypes)
                            {
                                <option value="@t.Value" selected="@(vehicleType == t.Value)">@t.Text</option>
                            }
                        }
                    </select>
                </div>
                <div class="col-md-2">
                    <label class="form-label small text-muted">Tòa nhà</label>
                    <select name="buildingId" class="form-select rounded-3">
                        <option value="">Tất cả</option>
                        @if (buildings != null)
                        {
                            foreach (var b in buildings)
                            {
                                <option value="@b.Value" selected="@(buildingId?.ToString() == b.Value)">@b.Text</option>
                            }
                        }
                    </select>
                </div>
                <div class="col-md-2">
                    <label class="form-label small text-muted">Số dòng</label>
                    <select name="pageSize" class="form-select rounded-3">
                        <option value="50" selected="@(pageSize == 50)">50</option>
                        <option value="100" selected="@(pageSize == 100)">100</option>
                        <option value="200" selected="@(pageSize == 200)">200</option>
                    </select>
                </div>
                <div class="col-md-2 d-flex gap-2">
                    <button class="btn btn-primary rounded-3 flex-fill"><i class="bi bi-search me-1"></i>Lọc</button>
                    <a asp-action="Index" class="btn btn-outline-secondary rounded-3"><i class="bi bi-arrow-clockwise"></i></a>
                </div>
            </form>

            <div class="table-responsive">
                <table class="table align-middle table-hover">
                    <thead class="table-light">
                        <tr><th>Sinh viên</th><th>MSSV</th><th>Phòng</th><th>Biển số</th><th>Loại xe</th><th>Trạng thái</th><th class="text-end">Thao tác</th></tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model)
                        {
                            <tr>
                                <td class="fw-semibold">@item.ResidentProfile?.FullName</td>
                                <td>@item.ResidentProfile?.StudentCode</td>
                                <td>@(item.ResidentProfile?.Apartment?.ApartmentCode ?? "-")</td>
                                <td class="fw-bold text-primary">@item.LicensePlate</td>
                                <td>@(item.VehicleType ?? "-")</td>
                                <td><span class="badge bg-success rounded-pill px-3 py-2">Đã duyệt</span></td>
                                <td class="text-end"><a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-outline-warning rounded-3">Sửa</a></td>
                            </tr>
                        }
                        @if (!Model.Any())
                        {
                            <tr><td colspan="7" class="text-center text-muted py-5">Không có biển số phù hợp.</td></tr>
                        }
                    </tbody>
                </table>
            </div>

            <div class="d-flex justify-content-between align-items-center flex-wrap gap-2 mt-3">
                <small class="text-muted">Hiển thị @Model.Count() / @totalCount biển số đã duyệt</small>
                <div class="btn-group btn-group-sm">
                    <a class="btn btn-outline-secondary @(currentPage <= 1 ? "disabled" : "")" asp-action="Index" asp-route-keyword="@keyword" asp-route-vehicleType="@vehicleType" asp-route-buildingId="@buildingId" asp-route-page="@(currentPage - 1)" asp-route-pageSize="@pageSize">Trước</a>
                    <span class="btn btn-light disabled">Trang @currentPage / @totalPages</span>
                    <a class="btn btn-outline-secondary @(currentPage >= totalPages ? "disabled" : "")" asp-action="Index" asp-route-keyword="@keyword" asp-route-vehicleType="@vehicleType" asp-route-buildingId="@buildingId" asp-route-page="@(currentPage + 1)" asp-route-pageSize="@pageSize">Sau</a>
                </div>
            </div>
        </div>
    </div>
</div>

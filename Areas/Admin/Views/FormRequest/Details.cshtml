@model QuanLyKTX.Models.StudentRequestForm
@{
    ViewData["Title"] = "Chi tiết biểu mẫu";
    Layout = "_AdminLayout";
    var approveButtonText = Model.FormType == "Đăng ký phòng" ? "Duyệt & phân phòng" : "Duyệt biểu mẫu";
}
<div class="container-fluid py-3">
    <div class="card border-0 shadow-sm rounded-4">
        <div class="card-body p-4">
            <h4 class="fw-bold mb-3">Chi tiết biểu mẫu</h4>

            @if (TempData["Success"] != null) { <div class="alert alert-success rounded-3">@TempData["Success"]</div> }
            @if (TempData["Error"] != null) { <div class="alert alert-warning rounded-3">@TempData["Error"]</div> }

            <div class="row g-3 mb-4">
                <div class="col-md-6"><b>Sinh viên:</b> @Model.ResidentProfile?.FullName</div>
                <div class="col-md-6"><b>MSSV:</b> @Model.ResidentProfile?.StudentCode</div>
                <div class="col-md-6"><b>Loại:</b> @Model.FormType</div>
                <div class="col-md-6"><b>Ngày gửi:</b> @Model.CreatedAt.ToString("dd/MM/yyyy HH:mm")</div>
                <div class="col-12"><b>Tiêu đề:</b> @Model.Title</div>
                <div class="col-12"><b>Nội dung:</b><pre class="bg-light rounded-3 p-3 mt-2">@Model.Content</pre></div>
                <div class="col-12"><b>File:</b> @if(Model.AttachmentPath!=null){<a href="@Model.AttachmentPath" target="_blank">@Model.OriginalFileName</a>}else{<span>-</span>}</div>
            </div>

            @if (Model.FormType == "Đăng ký phòng" && Model.Status == "Chờ duyệt")
            {
                <div class="alert alert-primary rounded-3">
                    Với biểu mẫu đăng ký phòng, sinh viên phải thanh toán hóa đơn nhận phòng trước. Sau khi hóa đơn đã thanh toán, admin duyệt thì hệ thống sẽ tự động gán phòng, cập nhật trạng thái sinh viên thành <b>Đang ở</b> và tăng số lượng hiện tại của phòng.
                </div>
            }

            @if(Model.Status == "Chờ duyệt"){
                <div class="row g-3">
                    <div class="col-md-6">
                        <form asp-action="Approve" method="post" class="border rounded-4 p-3">
                            @Html.AntiForgeryToken()<input type="hidden" name="id" value="@Model.Id" />
                            <label class="form-label fw-semibold">Ghi chú xử lý</label>
                            <textarea name="adminNote" class="form-control rounded-3 mb-3" rows="3"></textarea>
                            <button class="btn btn-success rounded-3">@approveButtonText</button>
                        </form>
                    </div>
                    <div class="col-md-6">
                        <form asp-action="Reject" method="post" class="border rounded-4 p-3">
                            @Html.AntiForgeryToken()<input type="hidden" name="id" value="@Model.Id" />
                            <label class="form-label fw-semibold">Lý do từ chối</label>
                            <textarea name="rejectReason" class="form-control rounded-3 mb-3" rows="3"></textarea>
                            <button class="btn btn-outline-danger rounded-3">Từ chối</button>
                        </form>
                    </div>
                </div>
            } else {
                <div class="alert alert-info rounded-3">Biểu mẫu đã xử lý: @Model.Status</div>
            }
            <a asp-action="Index" class="btn btn-light rounded-3 mt-3">Quay lại</a>
        </div>
    </div>
</div>

@model QuanLyKTX.Models.ResidentProfile

@{
    ViewData["Title"] = "Chi tiết cư dân - " + Model.FullName;
    var portraitPhotoPath = ViewBag.PortraitPhotoPath as string;
    var statusText = Model.Status == "Active" ? "Đang ở" : Model.Status;
    var statusClass = statusText switch
    {
        "Đang ở" => "bg-success-subtle text-success border-success-subtle",
        "Chờ thanh toán" => "bg-warning-subtle text-warning border-warning-subtle",
        "Chờ đăng ký phòng" => "bg-info-subtle text-info border-info-subtle",
        "Đã rời KTX" => "bg-secondary-subtle text-secondary border-secondary-subtle",
        _ => "bg-secondary-subtle text-secondary border-secondary-subtle"
    };
    var initial = !string.IsNullOrWhiteSpace(Model.FullName) ? Model.FullName.Trim()[0].ToString().ToUpper() : "SV";
}

<style>
    .resident-profile { display: grid; grid-template-columns: 280px 1fr; gap: 24px; }
    .portrait-box { background: #fff; border: 1px solid #e2e8f0; border-radius: 18px; padding: 22px; text-align: center; height: fit-content; }
    .portrait-img { width: 180px; height: 232px; border-radius: 14px; object-fit: cover; border: 4px solid #fff; box-shadow: 0 16px 32px rgba(15, 76, 129, .18); }
    .portrait-fallback { width: 180px; height: 232px; border-radius: 14px; margin: 0 auto; display: flex; align-items: center; justify-content: center; background: linear-gradient(135deg,#0f4c81,#1a73e8); color: #fff; font-size: 3rem; font-weight: 800; box-shadow: 0 16px 32px rgba(15, 76, 129, .18); }
    .info-grid { display: grid; grid-template-columns: repeat(12, 1fr); gap: 14px; }
    .info-cell { border: 1px solid #e2e8f0; background: #fff; border-radius: 14px; padding: 16px; min-height: 86px; }
    .info-cell small { display: block; color: #64748b; font-size: .68rem; font-weight: 800; text-transform: uppercase; margin-bottom: 4px; }
    .span-6 { grid-column: span 6; }
    .span-4 { grid-column: span 4; }
    .span-3 { grid-column: span 3; }
    .span-12 { grid-column: span 12; }
    @@media (max-width: 992px) { .resident-profile { grid-template-columns: 1fr; } }
    @@media (max-width: 768px) { .span-6, .span-4, .span-3 { grid-column: span 12; } }
</style>

<div class="container-fluid py-4">
    <div class="d-flex justify-content-between align-items-start flex-wrap gap-3 mb-4">
        <div>
            <h3 class="fw-bold text-dark mb-1"><i class="bi bi-person-badge-fill text-primary me-2"></i>Hồ sơ cư dân chi tiết</h3>
            <p class="text-muted mb-0">Thông tin định danh, phòng ở, thẻ KTX và phương tiện của sinh viên.</p>
        </div>
        <div class="d-flex gap-2 flex-wrap">
            <a asp-area="Admin" asp-controller="Resident" asp-action="Index" class="btn btn-outline-secondary rounded-pill px-4"><i class="bi bi-arrow-left me-1"></i>Quay lại</a>
            <a asp-area="Admin" asp-controller="Resident" asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-warning rounded-pill px-4 text-dark fw-bold"><i class="bi bi-pencil-square me-1"></i>Chỉnh sửa</a>
        </div>
    </div>

    <div class="resident-profile">
        <aside class="portrait-box shadow-sm">
            @if (!string.IsNullOrWhiteSpace(portraitPhotoPath))
            {
                <img src="@portraitPhotoPath" alt="Ảnh thẻ sinh viên @Model.FullName" class="portrait-img" />
            }
            else
            {
                <div class="portrait-fallback">@initial</div>
            }
            <div class="mt-3">
                <div class="fw-bold fs-5">@Model.FullName</div>
                <div class="text-primary fw-semibold">MSSV: @(Model.StudentCode ?? "-")</div>
                <span class="badge border @statusClass rounded-pill mt-2 px-3 py-2">@statusText</span>
            </div>
        </aside>

        <section>
            <div class="info-grid mb-4">
                <div class="info-cell span-6"><small>Họ và tên</small><div class="fw-bold fs-5 text-primary">@Model.FullName</div></div>
                <div class="info-cell span-3"><small>Mã số sinh viên</small><div class="fw-bold">@(Model.StudentCode ?? "-")</div></div>
                <div class="info-cell span-3"><small>Trạng thái cư trú</small><div class="fw-bold">@statusText</div></div>
                <div class="info-cell span-3"><small>Ngày sinh</small><div>@(Model.DateOfBirth?.ToString("dd/MM/yyyy") ?? "-")</div></div>
                <div class="info-cell span-3"><small>Giới tính</small><div>@(Model.Gender ?? "-")</div></div>
                <div class="info-cell span-3"><small>CCCD/Căn cước</small><div>@(Model.NationalId ?? "-")</div></div>
                <div class="info-cell span-3"><small>Số điện thoại</small><div>@(Model.PhoneNumber ?? "-")</div></div>
                <div class="info-cell span-6"><small>Email</small><div>@(Model.Email ?? "-")</div></div>
                <div class="info-cell span-3"><small>Lớp</small><div>@(Model.ClassName ?? "-")</div></div>
                <div class="info-cell span-3"><small>Khoa</small><div>@(Model.Faculty ?? "-")</div></div>
                <div class="info-cell span-12"><small>Địa chỉ</small><div>@(Model.Address ?? "-")</div></div>
            </div>

            <div class="row g-4">
                <div class="col-lg-4">
                    <div class="card border-0 shadow-sm rounded-4 h-100">
                        <div class="card-body p-4">
                            <h6 class="fw-bold mb-3"><i class="bi bi-door-open text-primary me-2"></i>Phòng lưu trú</h6>
                            @if (Model.Apartment != null)
                            {
                                <div class="fs-5 fw-bold">@Model.Apartment.ApartmentCode</div>
                                <div class="text-muted">@(Model.Apartment.Building?.Name ?? "Chưa có thông tin tòa")</div>
                            }
                            else
                            {
                                <div class="text-muted">Chưa gắn phòng KTX.</div>
                            }
                        </div>
                    </div>
                </div>

                <div class="col-lg-4">
                    <div class="card border-0 shadow-sm rounded-4 h-100">
                        <div class="card-body p-4">
                            <h6 class="fw-bold mb-3"><i class="bi bi-car-front text-info me-2"></i>Phương tiện</h6>
                            @if (Model.Vehicles != null && Model.Vehicles.Any())
                            {
                                foreach (var vehicle in Model.Vehicles)
                                {
                                    <div class="d-flex justify-content-between align-items-center border-bottom py-2">
                                        <div><div class="fw-bold">@vehicle.LicensePlate</div><small class="text-muted">@vehicle.VehicleType</small></div>
                                        <span class="badge bg-primary-subtle text-primary rounded-pill">@vehicle.Status</span>
                                    </div>
                                }
                            }
                            else
                            {
                                <div class="text-muted">Không có phương tiện đăng ký.</div>
                            }
                        </div>
                    </div>
                </div>

                <div class="col-lg-4">
                    <div class="card border-0 shadow-sm rounded-4 h-100">
                        <div class="card-body p-4">
                            <h6 class="fw-bold mb-3"><i class="bi bi-person-badge text-success me-2"></i>Thẻ KTX</h6>
                            @if (Model.ResidentCards != null && Model.ResidentCards.Any())
                            {
                                foreach (var card in Model.ResidentCards)
                                {
                                    <div class="d-flex justify-content-between align-items-center border-bottom py-2">
                                        <div><div class="fw-bold text-success">@card.CardCode</div><small class="text-muted">Cấp: @card.IssueDate.ToString("dd/MM/yyyy")</small></div>
                                        <span class="badge @(card.Status == "Active" ? "bg-success" : "bg-danger") rounded-pill">@(card.Status == "Active" ? "Hoạt động" : "Bị khóa")</span>
                                    </div>
                                }
                            }
                            else
                            {
                                <div class="text-muted">Chưa được cấp thẻ KTX.</div>
                            }
                        </div>
                    </div>
                </div>
            </div>
        </section>
    </div>
</div>

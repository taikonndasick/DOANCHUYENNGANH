@model QuanLyKTX.Models.ResidentProfile
@using Microsoft.AspNetCore.Mvc.Rendering

@{
    ViewData["Title"] = "Chỉnh sửa cư dân - " + Model.FullName;
}

<div class="container py-4">
    <div class="row">
        @* Tiêu đề trang *@
        <div class="col-12 mb-4">
            <h3 class="fw-bold text-dark">
                <i class="bi bi-pencil-square text-warning me-2"></i>Cập nhật hồ sơ cư dân
            </h3>
            <p class="text-muted">Chỉnh sửa thông tin cá nhân, căn hộ hoặc quản lý liên kết tài khoản cho <strong>@Model.FullName</strong>.</p>
        </div>
    </div>

    <form method="post">
        @Html.AntiForgeryToken()
        <input type="hidden" asp-for="Id" />
        <input type="hidden" asp-for="CreatedAt" />

        <div class="row">
            @* PHẦN CHÍNH: Bên trái (Thông tin cá nhân & Tài khoản) *@
            <div class="col-lg-8 mb-4">
                <div class="card border-0 shadow-sm rounded-4 mb-4">
                    <div class="card-header bg-white border-0 pt-4 ps-4">
                        <h5 class="fw-bold mb-0">Hồ sơ cá nhân</h5>
                    </div>
                    <div class="card-body p-4">
                        <div asp-validation-summary="ModelOnly" class="text-danger small mb-3"></div>

                        <div class="mb-4">
                            <label asp-for="FullName" class="form-label fw-bold">
                                <i class="bi bi-person me-1"></i> Họ và tên đầy đủ
                            </label>
                            <input asp-for="FullName" class="form-control form-control-lg shadow-none border-2 bg-light" />
                            <span asp-validation-for="FullName" class="text-danger small"></span>
                        </div>

                        <div class="row mb-4">
                            <div class="col-md-6 mb-3 mb-md-0">
                                <label asp-for="StudentCode" class="form-label fw-bold">
                                    <i class="bi bi-mortarboard me-1"></i> Mã số sinh viên
                                </label>
                                <input asp-for="StudentCode" class="form-control form-control-lg shadow-none border-2" maxlength="10" inputmode="numeric" pattern="[0-9]{10}" />
                                <span asp-validation-for="StudentCode" class="text-danger small"></span>
                            </div>
                            <div class="col-md-6">
                                <label asp-for="Gender" class="form-label fw-bold">
                                    <i class="bi bi-gender-ambiguous me-1"></i> Giới tính
                                </label>
                                <select asp-for="Gender" class="form-select form-select-lg shadow-none border-2">
                                    <option value="">-- Chọn giới tính --</option>
                                    <option value="Nam">Nam</option>
                                    <option value="Nữ">Nữ</option>
                                    <option value="Khác">Khác</option>
                                </select>
                                <span asp-validation-for="Gender" class="text-danger small"></span>
                            </div>
                        </div>

                        <div class="row mb-4">
                            <div class="col-md-6 mb-3 mb-md-0">
                                <label asp-for="DateOfBirth" class="form-label fw-bold">
                                    <i class="bi bi-calendar3 me-1"></i> Ngày sinh
                                </label>
                                <input asp-for="DateOfBirth" type="date" class="form-control form-control-lg shadow-none border-2" />
                                <span asp-validation-for="DateOfBirth" class="text-danger small"></span>
                            </div>
                            <div class="col-md-6">
                                <label asp-for="NationalId" class="form-label fw-bold">
                                    <i class="bi bi-card-heading me-1"></i> Số CCCD / Passport
                                </label>
                                <input asp-for="NationalId" class="form-control form-control-lg shadow-none border-2" />
                                <span asp-validation-for="NationalId" class="text-danger small"></span>
                            </div>
                        </div>

                        <div class="row mb-4">
                            <div class="col-md-6 mb-3 mb-md-0">
                                <label asp-for="PhoneNumber" class="form-label fw-bold">
                                    <i class="bi bi-telephone me-1"></i> Số điện thoại
                                </label>
                                <input asp-for="PhoneNumber" class="form-control form-control-lg shadow-none border-2" maxlength="10" inputmode="numeric" pattern="0[0-9]{9}" />
                                <span asp-validation-for="PhoneNumber" class="text-danger small"></span>
                            </div>
                            <div class="col-md-6">
                                <label asp-for="Email" class="form-label fw-bold">
                                    <i class="bi bi-envelope me-1"></i> Email
                                </label>
                                <input asp-for="Email" class="form-control form-control-lg shadow-none border-2" />
                                <span asp-validation-for="Email" class="text-danger small"></span>
                            </div>
                        </div>

                        <div class="row mb-4">
                            <div class="col-md-6 mb-3 mb-md-0">
                                <label asp-for="ClassName" class="form-label fw-bold">
                                    <i class="bi bi-journal-text me-1"></i> Lớp
                                </label>
                                <input asp-for="ClassName" class="form-control form-control-lg shadow-none border-2" />
                                <span asp-validation-for="ClassName" class="text-danger small"></span>
                            </div>
                            <div class="col-md-6">
                                <label asp-for="Faculty" class="form-label fw-bold">
                                    <i class="bi bi-building me-1"></i> Khoa
                                </label>
                                <input asp-for="Faculty" class="form-control form-control-lg shadow-none border-2" />
                                <span asp-validation-for="Faculty" class="text-danger small"></span>
                            </div>
                        </div>

                        <div class="mb-4">
                            <label asp-for="Address" class="form-label fw-bold">
                                <i class="bi bi-geo-alt me-1"></i> Địa chỉ
                            </label>
                            <input asp-for="Address" class="form-control form-control-lg shadow-none border-2" />
                            <span asp-validation-for="Address" class="text-danger small"></span>
                        </div>

                        <div class="mb-0">
                            <label asp-for="ApartmentId" class="form-label fw-bold">
                                <i class="bi bi-building me-1"></i> Căn hộ liên kết
                            </label>
                            <select asp-for="ApartmentId" class="form-select form-select-lg shadow-none border-2"
                                    asp-items="ViewBag.ApartmentId">
                                <option value="">-- Chọn căn hộ --</option>
                            </select>
                            <span asp-validation-for="ApartmentId" class="text-danger small"></span>
                        </div>
                    </div>
                </div>

                @* Khối Tài khoản liên kết *@
                <div class="card border-0 shadow-sm rounded-4">
                    <div class="card-header bg-white border-0 pt-4 ps-4">
                        <h5 class="fw-bold mb-0 text-primary">Tài khoản ứng dụng</h5>
                    </div>
                    <div class="card-body p-4">
                        <div class="mb-3">
                            <label class="form-label fw-bold">Liên kết tài khoản User</label>
                            <div class="input-group input-group-lg">
                                <span class="input-group-text bg-light border-2 border-end-0"><i class="bi bi-person-circle"></i></span>
                                <select asp-for="UserId" class="form-select shadow-none border-2 border-start-0 bg-light" asp-items="ViewBag.UserId">
                                    <option value="">-- Không liên kết tài khoản --</option>
                                </select>
                            </div>

                            <div class="mt-3">
                                @if (!string.IsNullOrEmpty(Model.UserId))
                                {
                                    <div class="d-flex align-items-center p-3 rounded-3 bg-success-subtle border border-success-subtle text-success">
                                        <i class="bi bi-shield-check fs-4 me-3"></i>
                                        <div>
                                            <div class="small fw-bold">Đang liên kết: @Model.User?.UserName</div>
                                            <div class="small">Tài khoản này có quyền truy cập App cư dân.</div>
                                        </div>
                                    </div>
                                }
                                else
                                {
                                    <div class="d-flex align-items-center p-3 rounded-3 bg-light border border-dashed text-muted">
                                        <i class="bi bi-link-45deg fs-4 me-3"></i>
                                        <div class="small italic">Cư dân này chưa được cấp tài khoản đăng nhập hệ thống.</div>
                                    </div>
                                }
                            </div>
                            <span asp-validation-for="UserId" class="text-danger small"></span>
                        </div>
                    </div>
                </div>
            </div>

            @* PHẦN PHỤ: Bên phải (Trạng thái & Thao tác) *@
            <div class="col-lg-4">
                <div class="card border-0 shadow-sm rounded-4 mb-4">
                    <div class="card-body p-4">
                        <h6 class="fw-bold mb-3 text-muted small text-uppercase">Tình trạng hồ sơ</h6>

                        <div class="mb-4">
                            <label asp-for="Status" class="form-label small text-muted fw-bold">TRẠNG THÁI CƯ TRÚ</label>
                            <select asp-for="Status" class="form-select shadow-none bg-light border-0 fw-bold text-primary py-2">
                                <option value="Chờ đăng ký phòng">Chờ đăng ký phòng</option>
                                <option value="Chờ thanh toán">Chờ thanh toán</option>
                                <option value="Đang ở">Đang ở</option>
                                <option value="Tạm vắng">Tạm vắng</option>
                                <option value="Đã rời KTX">Đã rời KTX</option>
                                <option value="Bị khóa">Bị khóa</option>
                            </select>
                            <span asp-validation-for="Status" class="text-danger small"></span>
                        </div>

                        <hr class="text-muted opacity-25">

                        <div class="d-grid gap-2">
                            <button type="submit" class="btn btn-warning btn-lg rounded-3 fw-bold py-3 shadow text-dark">
                                <i class="bi bi-save me-1"></i> CẬP NHẬT HỒ SƠ
                            </button>
                            <a asp-area="Admin" asp-controller="Resident" asp-action="Index"
                               class="btn btn-link text-secondary text-decoration-none small mt-2">
                                <i class="bi bi-x-circle me-1"></i> Hủy bỏ thay đổi
                            </a>
                        </div>
                    </div>
                </div>

                @* Widget hướng dẫn *@
                <div class="alert alert-warning border-0 rounded-4 shadow-sm p-4">
                    <h6 class="fw-bold"><i class="bi bi-exclamation-triangle me-2"></i>Lưu ý quan trọng</h6>
                    <small class="d-block mb-2">Việc thay đổi <strong>Căn hộ</strong> có thể dẫn đến việc thay đổi các hóa đơn và dịch vụ đang đăng ký theo căn hộ cũ.</small>
                </div>
            </div>
        </div>
    </form>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}

<style>
    .bg-success-subtle {
        background-color: rgba(25, 135, 84, 0.1) !important;
    }

    .border-dashed {
        border-style: dashed !important;
    }
</style>

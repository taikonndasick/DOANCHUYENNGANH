@model QuanLyKTX.Models.ResidentProfile

@{
    ViewData["Title"] = "Thêm sinh viên mới";
}

<div class="container py-4">
    <div class="row">
        <div class="col-12 mb-4">
            <h3 class="fw-bold text-dark">
                <i class="bi bi-person-plus-fill text-primary me-2"></i>Tiếp nhận sinh viên mới
            </h3>
            <p class="text-muted">Khởi tạo hồ sơ sinh viên và liên kết phòng ở tại KTX HUTECH.</p>
        </div>
    </div>

    <form method="post" asp-area="Admin" asp-controller="Resident" asp-action="Create">
        @Html.AntiForgeryToken()

        <div class="row">
            <div class="col-lg-8 mb-4">
                <div class="card border-0 shadow-sm rounded-4 h-100">
                    <div class="card-header bg-white border-0 pt-4 ps-4">
                        <h5 class="fw-bold mb-0">Thông tin sinh viên</h5>
                    </div>

                    <div class="card-body p-4">
                        <div asp-validation-summary="ModelOnly" class="text-danger small mb-3"></div>

                        <div class="row mb-4">
                            <div class="col-md-8">
                                <label asp-for="FullName" class="form-label fw-bold">
                                    <i class="bi bi-person me-1"></i> Họ và tên sinh viên
                                </label>
                                <input asp-for="FullName" class="form-control form-control-lg shadow-none border-2 bg-light"
                                       placeholder="VD: Nguyễn Văn A" />
                                <span asp-validation-for="FullName" class="text-danger small"></span>
                            </div>

                            <div class="col-md-4 mt-3 mt-md-0">
                                <label asp-for="StudentCode" class="form-label fw-bold">
                                    <i class="bi bi-mortarboard me-1"></i> Mã số sinh viên
                                </label>
                                <input asp-for="StudentCode" class="form-control form-control-lg shadow-none border-2"
                                       placeholder="VD: 2380600000" maxlength="10" inputmode="numeric" pattern="[0-9]{10}" />
                                <span asp-validation-for="StudentCode" class="text-danger small"></span>
                            </div>
                        </div>

                        <div class="row mb-4">
                            <div class="col-md-4">
                                <label asp-for="DateOfBirth" class="form-label fw-bold">
                                    <i class="bi bi-calendar3 me-1"></i> Ngày sinh
                                </label>
                                <input asp-for="DateOfBirth" type="date" class="form-control form-control-lg shadow-none border-2" />
                                <span asp-validation-for="DateOfBirth" class="text-danger small"></span>
                            </div>

                            <div class="col-md-4 mt-3 mt-md-0">
                                <label asp-for="Gender" class="form-label fw-bold">
                                    <i class="bi bi-gender-ambiguous me-1"></i> Giới tính
                                </label>
                                <select asp-for="Gender" class="form-select form-select-lg shadow-none border-2">
                                    <option value="">-- Chọn giới tính --</option>
                                    <option value="Nam">Nam</option>
                                    <option value="Nữ">Nữ</option>
                                    <option value="Khác">Khác</option>
                                </select>
                                <span asp-validation-for="Gender" class="text-danger small"></span>
                            </div>

                            <div class="col-md-4 mt-3 mt-md-0">
                                <label asp-for="NationalId" class="form-label fw-bold">
                                    <i class="bi bi-card-heading me-1"></i> Số CCCD
                                </label>
                                <input asp-for="NationalId" class="form-control form-control-lg shadow-none border-2"
                                       placeholder="Nhập 12 số CCCD" />
                                <span asp-validation-for="NationalId" class="text-danger small"></span>
                            </div>
                        </div>

                        <div class="row mb-4">
                            <div class="col-md-6">
                                <label asp-for="PhoneNumber" class="form-label fw-bold">
                                    <i class="bi bi-telephone me-1"></i> Số điện thoại
                                </label>
                                <input asp-for="PhoneNumber" class="form-control form-control-lg shadow-none border-2"
                                       placeholder="VD: 0901234567" maxlength="10" inputmode="numeric" pattern="0[0-9]{9}" />
                                <span asp-validation-for="PhoneNumber" class="text-danger small"></span>
                            </div>

                            <div class="col-md-6 mt-3 mt-md-0">
                                <label asp-for="Email" class="form-label fw-bold">
                                    <i class="bi bi-envelope me-1"></i> Email
                                </label>
                                <input asp-for="Email" class="form-control form-control-lg shadow-none border-2"
                                       placeholder="VD: sinhvien@email.com" />
                                <span asp-validation-for="Email" class="text-danger small"></span>
                            </div>
                        </div>

                        <div class="row mb-4">
                            <div class="col-md-6">
                                <label asp-for="ClassName" class="form-label fw-bold">
                                    <i class="bi bi-journal-text me-1"></i> Lớp
                                </label>
                                <input asp-for="ClassName" class="form-control form-control-lg shadow-none border-2"
                                       placeholder="VD: 23DTHD4" />
                                <span asp-validation-for="ClassName" class="text-danger small"></span>
                            </div>

                            <div class="col-md-6 mt-3 mt-md-0">
                                <label asp-for="Faculty" class="form-label fw-bold">
                                    <i class="bi bi-building me-1"></i> Khoa
                                </label>
                                <input asp-for="Faculty" class="form-control form-control-lg shadow-none border-2"
                                       placeholder="VD: Công nghệ thông tin" />
                                <span asp-validation-for="Faculty" class="text-danger small"></span>
                            </div>
                        </div>

                        <div class="mb-4">
                            <label asp-for="Address" class="form-label fw-bold">
                                <i class="bi bi-geo-alt me-1"></i> Địa chỉ
                            </label>
                            <input asp-for="Address" class="form-control form-control-lg shadow-none border-2"
                                   placeholder="Nhập địa chỉ liên hệ" />
                            <span asp-validation-for="Address" class="text-danger small"></span>
                        </div>

                        <div class="mb-0">
                            <label asp-for="ApartmentId" class="form-label fw-bold">
                                <i class="bi bi-door-open me-1"></i> Phòng KTX
                            </label>
                            <select asp-for="ApartmentId" class="form-select form-select-lg shadow-none border-2"
                                    asp-items="ViewBag.ApartmentId">
                                <option value="">-- Chọn phòng KTX --</option>
                            </select>
                            <span asp-validation-for="ApartmentId" class="text-danger small"></span>
                            <small class="text-muted fst-italic mt-2 d-block">
                                Lưu ý: Chỉ nên gán sinh viên vào phòng còn chỗ hoặc phòng hợp lệ.
                            </small>
                        </div>
                    </div>
                </div>
            </div>

            <div class="col-lg-4">
                <div class="card border-0 shadow-sm rounded-4 mb-4">
                    <div class="card-body p-4">
                        <h6 class="fw-bold mb-3 text-muted small text-uppercase">Quản lý trạng thái</h6>

                        <div class="mb-4">
                            <label asp-for="Status" class="form-label small text-muted fw-bold">TRẠNG THÁI SINH VIÊN</label>
                            <select asp-for="Status" class="form-select shadow-none bg-light border-0 fw-bold text-primary py-2">
                                <option value="Chờ đăng ký phòng">Chờ đăng ký phòng</option>
                                <option value="Chờ thanh toán">Chờ thanh toán</option>
                                <option value="Đang ở">Đang ở</option>
                                <option value="Tạm vắng">Tạm vắng</option>
                                <option value="Đã rời KTX">Đã rời KTX</option>
                                <option value="Bị khóa">Bị khóa</option>
                            </select>
                            <span asp-validation-for="Status" class="text-danger small"></span>
                        </div>

                        <hr class="text-muted opacity-25" />

                        <div class="d-grid gap-2">
                            <button type="submit" class="btn btn-primary btn-lg rounded-3 fw-bold py-3 shadow">
                                <i class="bi bi-save me-1"></i> LƯU HỒ SƠ
                            </button>

                            <a asp-area="Admin" asp-controller="Resident" asp-action="Index"
                                   class="btn btn-link text-secondary text-decoration-none small mt-2">
                                <i class="bi bi-arrow-left me-1"></i> Hủy và quay lại
                            </a>
                        </div>
                    </div>
                </div>

                <div class="alert alert-primary border-0 rounded-4 shadow-sm p-4">
                    <h6 class="fw-bold">
                        <i class="bi bi-lightbulb me-2"></i>Quy trình tiếp theo
                    </h6>
                    <small class="d-block mb-2">Sau khi lưu hồ sơ, ban quản lý có thể tiến hành:</small>
                    <ul class="small ps-3 mb-0">
                        <li>Gán phòng KTX cho sinh viên</li>
                        <li>Cấp thẻ KTX</li>
                        <li>Đăng ký biển số xe nếu có</li>
                        <li>Theo dõi hóa đơn và thông báo</li>
                    </ul>
                </div>
            </div>
        </div>
    </form>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}

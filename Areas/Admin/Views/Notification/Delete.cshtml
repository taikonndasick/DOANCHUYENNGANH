@model QuanLyKTX.Models.Notification

@{
    ViewData["Title"] = "Xác nhận xóa thông báo";
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-md-7 col-lg-6">
            @* Khối cảnh báo chính *@
            <div class="card border-0 shadow-lg rounded-4 overflow-hidden">
                <div class="card-body p-5 text-center">
                    <div class="mb-4">
                        <i class="bi bi-trash3 text-danger display-1"></i>
                    </div>
                    <h3 class="fw-bold text-dark">Gỡ bỏ thông báo?</h3>
                    <p class="text-muted">Hành động này sẽ xóa vĩnh viễn tin tức này khỏi ứng dụng của cư dân. Bạn không thể hoàn tác sau khi xác nhận.</p>

                    @* Tóm tắt nội dung sắp xóa *@
                    <div class="p-4 bg-light rounded-4 my-4 text-start border border-danger-subtle">
                        <div class="mb-3">
                            <span class="text-muted small fw-bold text-uppercase d-block mb-1">Tiêu đề tin bài:</span>
                            <div class="fw-bold text-dark">@Model.Title</div>
                        </div>

                        <div class="row align-items-center">
                            <div class="col-sm-6">
                                <span class="text-muted small fw-bold text-uppercase d-block mb-1">Ngày phát hành:</span>
                                <div class="small text-dark fw-medium">@Model.CreatedAt.ToString("dd/MM/yyyy HH:mm")</div>
                            </div>
                            @if (!string.IsNullOrEmpty(Model.ImagePath))
                            {
                                <div class="col-sm-6 text-sm-end mt-3 mt-sm-0">
                                    <img src="@Model.ImagePath" class="rounded-3 border shadow-sm" style="width: 80px; height: 60px; object-fit: cover;" alt="Thumbnail" />
                                </div>
                            }
                        </div>
                    </div>

                    @* Form xác nhận *@
                    <form asp-action="DeleteConfirmed" method="post">
                        @Html.AntiForgeryToken()
                        <input type="hidden" asp-for="Id" />

                        <div class="d-grid gap-3">
                            <button type="submit" class="btn btn-danger btn-lg rounded-pill fw-bold py-3 shadow-sm">
                                <i class="bi bi-eraser-fill me-2"></i>XÁC NHẬN XÓA TIN
                            </button>
                            <a asp-action="Index" class="btn btn-link text-secondary text-decoration-none fw-bold">
                                Không, giữ lại thông báo này
                            </a>
                        </div>
                    </form>
                </div>
            </div>

            @* Widget cảnh báo hệ lụy *@
            <div class="alert alert-secondary border-0 rounded-4 shadow-sm p-4 mt-4">
                <div class="d-flex align-items-center">
                    <i class="bi bi-info-circle-fill fs-3 me-3 opacity-50"></i>
                    <small class="text-dark opacity-75">
                        Lưu ý: Sau khi xóa, các tệp hình ảnh và PDF đính kèm liên quan cũng sẽ được hệ thống xem xét gỡ bỏ để giải phóng dung lượng bộ nhớ.
                    </small>
                </div>
            </div>
        </div>
    </div>
</div>

<style>
    /* Hiệu ứng rung nhẹ cho Icon cảnh báo */
    .display-1 {
        display: inline-block;
        animation: shakeVertical 2s ease-in-out infinite;
    }

    @@keyframes shakeVertical {
        0%, 100% {
            transform: translateY(0);
        }

        50% {
            transform: translateY(-10px);
        }
    }

    .btn-danger {
        background-color: #dc3545;
        border: none;
    }

        .btn-danger:hover {
            background-color: #bb2d3b;
            transform: scale(1.02);
            transition: all 0.2s;
        }
</style>
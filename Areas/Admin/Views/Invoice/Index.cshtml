@model List<QuanLyKTX.Models.Invoice>
@{
    ViewData["Title"] = "Danh sách hóa đơn";
    var keyword = ViewBag.Keyword as string ?? "";
    var status = ViewBag.Status as string ?? "Tất cả";
    var dueState = ViewBag.DueState as string ?? "Tất cả";
    var fromDate = ViewBag.FromDate as string ?? "";
    var toDate = ViewBag.ToDate as string ?? "";
    var currentPage = (int)(ViewBag.CurrentPage ?? 1);
    var totalPages = (int)(ViewBag.TotalPages ?? 1);
    var pageSize = (int)(ViewBag.PageSize ?? 50);
    var totalCount = (int)(ViewBag.TotalCount ?? Model.Count);
}

<style>
    .table-custom thead th { background-color: #f8f9fa; text-transform: uppercase; font-size: .75rem; letter-spacing: .5px; font-weight: 700; color: #475569; border-top: none; }
    .btn-action { width: 32px; height: 32px; padding: 0; display: inline-flex; align-items: center; justify-content: center; border-radius: 8px; }
    .badge-status { padding: .5em .8em; font-weight: 600; border-radius: 6px; }
</style>

<div class="card border-0 shadow-sm rounded-4">
    <div class="card-header bg-white border-0 py-3 d-flex justify-content-between align-items-center">
        <div>
            <h5 class="fw-bold mb-1 text-dark"><i class="bi bi-receipt me-2 text-primary"></i>Danh sách hóa đơn</h5>
            <small class="text-muted">Tìm kiếm theo mã hóa đơn, sinh viên, trạng thái và khoảng ngày.</small>
        </div>
        <a asp-area="Admin" asp-controller="Invoice" asp-action="Create" class="btn btn-primary btn-sm rounded-pill px-3 shadow-sm"><i class="bi bi-plus-lg me-1"></i>Tạo hóa đơn</a>
    </div>

    <div class="card-body border-top">
        <form method="get" class="row g-2 align-items-end">
            <div class="col-md-3">
                <label class="form-label small text-muted">Từ khóa</label>
                <input name="keyword" value="@keyword" class="form-control rounded-3" placeholder="Mã hóa đơn, sinh viên, MSSV..." />
            </div>
            <div class="col-md-2">
                <label class="form-label small text-muted">Trạng thái</label>
                <select name="status" class="form-select rounded-3">
                    <option value="Tất cả" selected="@(status == "Tất cả")">Tất cả</option>
                    <option value="Unpaid" selected="@(status == "Unpaid")">Chưa thanh toán</option>
                    <option value="Pending" selected="@(status == "Pending")">Đang chờ</option>
                    <option value="Paid" selected="@(status == "Paid")">Đã thanh toán</option>
                    <option value="Cancelled" selected="@(status == "Cancelled")">Đã hủy</option>
                </select>
            </div>
            <div class="col-md-2">
                <label class="form-label small text-muted">Hạn thanh toán</label>
                <select name="dueState" class="form-select rounded-3">
                    <option value="Tất cả" selected="@(dueState == "Tất cả")">Tất cả</option>
                    <option value="Còn hạn" selected="@(dueState == "Còn hạn")">Còn hạn</option>
                    <option value="Quá hạn" selected="@(dueState == "Quá hạn")">Quá hạn</option>
                </select>
            </div>
            <div class="col-md-2">
                <label class="form-label small text-muted">Từ ngày lập</label>
                <input type="date" name="fromDate" value="@fromDate" class="form-control rounded-3" />
            </div>
            <div class="col-md-2">
                <label class="form-label small text-muted">Đến ngày lập</label>
                <input type="date" name="toDate" value="@toDate" class="form-control rounded-3" />
            </div>
            <div class="col-md-1">
                <label class="form-label small text-muted">Dòng</label>
                <select name="pageSize" class="form-select rounded-3">
                    <option value="50" selected="@(pageSize == 50)">50</option>
                    <option value="100" selected="@(pageSize == 100)">100</option>
                    <option value="200" selected="@(pageSize == 200)">200</option>
                </select>
            </div>
            <div class="col-12 d-flex justify-content-end gap-2 mt-2">
                <a asp-action="Index" class="btn btn-outline-secondary rounded-3"><i class="bi bi-arrow-clockwise me-1"></i>Xóa lọc</a>
                <button class="btn btn-primary rounded-3"><i class="bi bi-search me-1"></i>Lọc hóa đơn</button>
            </div>
        </form>
    </div>

    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover table-custom align-middle mb-0">
                <thead>
                    <tr><th class="ps-4">ID</th><th>Mã hóa đơn</th><th>Sinh viên</th><th>Nội dung</th><th>Ngày lập</th><th>Hạn thanh toán</th><th class="text-end">Tổng tiền</th><th>Trạng thái</th><th class="text-center pe-4">Thao tác</th></tr>
                </thead>
                <tbody>
                    @if (!Model.Any())
                    {
                        <tr><td colspan="9" class="text-center text-muted py-4"><i class="bi bi-inbox me-1"></i>Không có hóa đơn phù hợp.</td></tr>
                    }
                    else
                    {
                        foreach (var item in Model)
                        {
                            var statusText = item.Status switch { "Paid" => "Đã thanh toán", "Unpaid" => "Chưa thanh toán", "Pending" => "Đang chờ", "Cancelled" => "Đã hủy", _ => item.Status };
                            var statusClass = item.Status switch { "Paid" => "bg-success-subtle text-success", "Unpaid" => "bg-danger-subtle text-danger", "Pending" => "bg-warning-subtle text-warning", "Cancelled" => "bg-secondary-subtle text-secondary", _ => "bg-secondary-subtle text-secondary" };
                            <tr>
                                <td class="ps-4 text-muted fw-bold">#@item.Id</td>
                                <td><span class="fw-bold text-dark">@item.InvoiceCode</span></td>
                                <td><div class="fw-medium text-secondary">@(item.ResidentProfile?.FullName ?? "-")</div><small class="text-muted">@(item.ResidentProfile?.StudentCode ?? "")</small></td>
                                <td>
                                    @if (item.ServiceBooking?.Service != null)
                                    {
                                        <div class="fw-bold text-dark" style="font-size: .9rem;">@item.ServiceBooking.Service.Name</div>
                                        <div class="text-muted" style="font-size: .75rem;">Mã đặt: #@item.ServiceBookingId</div>
                                    }
                                    else
                                    {
                                        <span class="text-muted small">@(item.Description ?? "N/A")</span>
                                    }
                                </td>
                                <td>@item.CreatedAt.ToString("dd/MM/yyyy")</td>
                                <td>@(item.DueDate?.ToString("dd/MM/yyyy") ?? "-")</td>
                                <td class="text-end fw-bold text-danger">@item.TotalAmount.ToString("N0") <small>đ</small></td>
                                <td><span class="badge @statusClass badge-status">@statusText</span></td>
                                <td class="text-center pe-4">
                                    <div class="d-flex justify-content-center gap-2">
                                        <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-action btn-outline-info" title="Chi tiết"><i class="bi bi-eye"></i></a>
                                        <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-action btn-outline-warning" title="Sửa"><i class="bi bi-pencil"></i></a>
                                        <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-action btn-outline-danger" title="Xóa"><i class="bi bi-trash"></i></a>
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>

    <div class="card-footer bg-white border-0 py-3 d-flex justify-content-between align-items-center flex-wrap gap-2">
        <small class="text-muted">Hiển thị @Model.Count / @totalCount hóa đơn</small>
        <div class="btn-group btn-group-sm">
            <a class="btn btn-outline-secondary @(currentPage <= 1 ? "disabled" : "")" asp-action="Index" asp-route-keyword="@keyword" asp-route-status="@status" asp-route-dueState="@dueState" asp-route-fromDate="@fromDate" asp-route-toDate="@toDate" asp-route-page="@(currentPage - 1)" asp-route-pageSize="@pageSize">Trước</a>
            <span class="btn btn-light disabled">Trang @currentPage / @totalPages</span>
            <a class="btn btn-outline-secondary @(currentPage >= totalPages ? "disabled" : "")" asp-action="Index" asp-route-keyword="@keyword" asp-route-status="@status" asp-route-dueState="@dueState" asp-route-fromDate="@fromDate" asp-route-toDate="@toDate" asp-route-page="@(currentPage + 1)" asp-route-pageSize="@pageSize">Sau</a>
        </div>
    </div>
</div>

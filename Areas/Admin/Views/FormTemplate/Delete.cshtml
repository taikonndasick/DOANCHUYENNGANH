@model QuanLyKTX.Models.FormTemplate
@{
    ViewData["Title"] = "Xóa biểu mẫu";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<div class="card border-0 shadow-sm rounded-4">
    <div class="card-body p-4">
        <h3 class="fw-bold text-danger mb-3"><i class="bi bi-trash me-2"></i>Xóa biểu mẫu</h3>
        <p>Bạn có chắc muốn xóa biểu mẫu này không?</p>
        <div class="alert alert-warning rounded-3">
            <div class="fw-bold">@Model.Name</div>
            <div>Loại: @Model.Type</div>
            <small>@Model.Description</small>
        </div>
        <form asp-action="Delete" method="post">
            @Html.AntiForgeryToken()
            <input type="hidden" asp-for="Id" />
            <button class="btn btn-danger"><i class="bi bi-trash me-1"></i>Xóa</button>
            <a asp-action="Index" class="btn btn-light border">Hủy</a>
        </form>
    </div>
</div>

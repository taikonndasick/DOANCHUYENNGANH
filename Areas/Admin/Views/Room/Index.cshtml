@model List<QuanLyKTX.Models.Apartment>
@using Microsoft.AspNetCore.Mvc.Rendering
@{
    ViewData["Title"] = "Danh sách phòng KTX";
    var keyword = ViewBag.Keyword as string ?? "";
    var status = ViewBag.Status as string ?? "Tất cả";
    var roomType = ViewBag.RoomType as string ?? "Tất cả";
    int? buildingId = ViewBag.BuildingId as int?;
    int? floor = ViewBag.Floor as int?;
    var currentPage = (int)(ViewBag.CurrentPage ?? 1);
    var totalPages = (int)(ViewBag.TotalPages ?? 1);
    var pageSize = (int)(ViewBag.PageSize ?? 50);
    var totalCount = (int)(ViewBag.TotalCount ?? Model.Count);
    var buildings = ViewBag.Buildings as SelectList;
    var roomTypes = ViewBag.RoomTypes as SelectList;
}

<style>
    .table-custom thead th { background-color: #f8f9fa; text-transform: uppercase; font-size: .75rem; letter-spacing: .5px; font-weight: 700; color: #475569; border-top: none; }
    .btn-action { width: 32px; height: 32px; padding: 0; display: inline-flex; align-items: center; justify-content: center; border-radius: 8px; }
    .badge-room { padding: .5em .8em; font-weight: 600; border-radius: 6px; font-size: .8rem; }
</style>

<div class="card border-0 shadow-sm rounded-4">
    <div class="card-header bg-white border-0 py-3 d-flex justify-content-between align-items-center">
        <div>
            <h5 class="fw-bold mb-1 text-dark"><i class="bi bi-door-open-fill me-2 text-primary"></i>Danh sách phòng KTX</h5>
            <small class="text-muted">Tìm kiếm theo phòng, tòa, tầng, loại phòng và trạng thái.</small>
        </div>
        <a asp-area="Admin" asp-controller="Room" asp-action="Create" class="btn btn-primary btn-sm rounded-pill px-3 shadow-sm"><i class="bi bi-plus-circle me-1"></i>Thêm phòng</a>
    </div>

    <div class="card-body border-top">
        <form method="get" class="row g-2 align-items-end">
            <div class="col-md-3">
                <label class="form-label small text-muted">Từ khóa</label>
                <input name="keyword" value="@keyword" class="form-control rounded-3" placeholder="A1.01.02, Phòng 4 người..." />
            </div>
            <div class="col-md-2">
                <label class="form-label small text-muted">Tòa nhà</label>
                <select name="buildingId" class="form-select rounded-3">
                    <option value="">Tất cả</option>
                    @if (buildings != null)
                    {
                        foreach (var b in buildings)
                        {
                            <option value="@b.Value" selected="@(buildingId?.ToString() == b.Value)">@b.Text</option>
                        }
                    }
                </select>
            </div>
            <div class="col-md-2">
                <label class="form-label small text-muted">Loại phòng</label>
                <select name="roomType" class="form-select rounded-3">
                    <option value="Tất cả">Tất cả</option>
                    @if (roomTypes != null)
                    {
                        foreach (var rt in roomTypes)
                        {
                            <option value="@rt.Value" selected="@(roomType == rt.Value)">@rt.Text</option>
                        }
                    }
                </select>
            </div>
            <div class="col-md-2">
                <label class="form-label small text-muted">Trạng thái</label>
                <select name="status" class="form-select rounded-3">
                    <option value="Tất cả" selected="@(status == "Tất cả")">Tất cả</option>
                    <option value="Còn chỗ" selected="@(status == "Còn chỗ")">Còn chỗ</option>
                    <option value="Đã đầy" selected="@(status == "Đã đầy")">Đã đầy</option>
                    <option value="Bảo trì" selected="@(status == "Bảo trì")">Bảo trì</option>
                    <option value="Ngưng sử dụng" selected="@(status == "Ngưng sử dụng")">Ngưng sử dụng</option>
                </select>
            </div>
            <div class="col-md-1">
                <label class="form-label small text-muted">Tầng</label>
                <input type="number" name="floor" value="@floor" min="1" max="99" class="form-control rounded-3" />
            </div>
            <div class="col-md-1">
                <label class="form-label small text-muted">Dòng</label>
                <select name="pageSize" class="form-select rounded-3">
                    <option value="50" selected="@(pageSize == 50)">50</option>
                    <option value="100" selected="@(pageSize == 100)">100</option>
                    <option value="200" selected="@(pageSize == 200)">200</option>
                </select>
            </div>
            <div class="col-md-1 d-flex gap-2">
                <button class="btn btn-primary rounded-3 flex-fill"><i class="bi bi-search"></i></button>
                <a asp-action="Index" class="btn btn-outline-secondary rounded-3"><i class="bi bi-arrow-clockwise"></i></a>
            </div>
        </form>
    </div>

    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover table-custom align-middle mb-0">
                <thead>
                    <tr>
                        <th class="ps-4">ID</th><th>Mã phòng</th><th>Tòa nhà</th><th>Loại phòng</th><th>Tầng</th><th>Sức chứa</th><th>Slot trống</th><th>Giá phòng</th><th>Trạng thái</th><th class="text-center pe-4">Thao tác</th>
                    </tr>
                </thead>
                <tbody>
                    @if (!Model.Any())
                    {
                        <tr><td colspan="10" class="text-center text-muted py-4"><i class="bi bi-inbox me-1"></i>Không có phòng phù hợp.</td></tr>
                    }
                    else
                    {
                        foreach (var item in Model)
                        {
                            var emptySlot = Math.Max(0, item.MaxOccupancy - item.CurrentOccupancy);
                            var statusClass = item.Status switch { "Còn chỗ" => "bg-success-subtle text-success", "Đã đầy" => "bg-danger-subtle text-danger", "Bảo trì" => "bg-warning-subtle text-warning", _ => "bg-secondary-subtle text-secondary" };
                            <tr>
                                <td class="ps-4 text-muted fw-bold">#@item.Id</td>
                                <td><span class="fw-bold text-primary"><i class="bi bi-door-open me-1"></i>@item.ApartmentCode</span></td>
                                <td>@(item.Building?.Name ?? "Chưa gắn tòa")</td>
                                <td>@item.ApartmentType</td>
                                <td>@(item.Floor?.ToString() ?? "-")</td>
                                <td><span class="fw-semibold">@item.CurrentOccupancy/@item.MaxOccupancy</span></td>
                                <td><span class="badge @(emptySlot > 0 ? "bg-info-subtle text-info" : "bg-danger-subtle text-danger") fw-bold">@emptySlot slot</span></td>
                                <td>@item.RoomPrice.ToString("N0") đ</td>
                                <td><span class="badge @statusClass badge-room">@item.Status</span></td>
                                <td class="text-center pe-4"><a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-action btn-outline-warning" title="Sửa phòng"><i class="bi bi-pencil"></i></a></td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>

    <div class="card-footer bg-white border-0 py-3 d-flex justify-content-between align-items-center flex-wrap gap-2">
        <small class="text-muted">Hiển thị @Model.Count / @totalCount phòng KTX</small>
        <div class="btn-group btn-group-sm">
            <a class="btn btn-outline-secondary @(currentPage <= 1 ? "disabled" : "")" asp-action="Index" asp-route-keyword="@keyword" asp-route-buildingId="@buildingId" asp-route-roomType="@roomType" asp-route-status="@status" asp-route-floor="@floor" asp-route-page="@(currentPage - 1)" asp-route-pageSize="@pageSize">Trước</a>
            <span class="btn btn-light disabled">Trang @currentPage / @totalPages</span>
            <a class="btn btn-outline-secondary @(currentPage >= totalPages ? "disabled" : "")" asp-action="Index" asp-route-keyword="@keyword" asp-route-buildingId="@buildingId" asp-route-roomType="@roomType" asp-route-status="@status" asp-route-floor="@floor" asp-route-page="@(currentPage + 1)" asp-route-pageSize="@pageSize">Sau</a>
        </div>
    </div>
</div>

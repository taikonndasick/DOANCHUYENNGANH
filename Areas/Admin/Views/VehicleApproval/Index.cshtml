@model IEnumerable<QuanLyKTX.Models.Vehicle>
@{ ViewData["Title"] = "Duyệt biển số xe"; Layout = "_AdminLayout"; }
<div class="container-fluid py-3">
    <div class="card border-0 shadow-sm rounded-4">
        <div class="card-body p-4">
            <div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-2">
                <div>
                    <h4 class="fw-bold mb-1"><i class="bi bi-car-front-fill me-2 text-primary"></i>Duyệt đăng ký biển số xe</h4>
                    <p class="text-muted mb-0">Chỉ hiển thị đăng ký biển số đang chờ duyệt.</p>
                </div>
            </div>

            <form method="get" class="row g-2 mb-3">
                <div class="col-md-5"><input name="keyword" value="@ViewBag.Keyword" class="form-control rounded-3" placeholder="Tìm theo biển số, sinh viên, MSSV..." /></div>
                <div class="col-md-auto"><button class="btn btn-primary rounded-3"><i class="bi bi-search"></i> Tìm kiếm</button></div>
            </form>

            @if (TempData["Success"] != null) { <div class="alert alert-success rounded-3">@TempData["Success"]</div> }
            @if (TempData["Error"] != null) { <div class="alert alert-warning rounded-3">@TempData["Error"]</div> }

            <div class="table-responsive">
                <table class="table align-middle table-hover">
                    <thead class="table-light">
                        <tr>
                            <th>Sinh viên</th>
                            <th>MSSV</th>
                            <th>Biển số</th>
                            <th>Loại xe</th>
                            <th>Ảnh biển số</th>
                            <th>Trạng thái</th>
                            <th class="text-end">Thao tác</th>
                        </tr>
                    </thead>
                    <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td class="fw-semibold">@item.ResidentProfile?.FullName</td>
                            <td>@item.ResidentProfile?.StudentCode</td>
                            <td class="fw-bold text-primary">@item.LicensePlate</td>
                            <td>@item.VehicleType</td>
                            <td>
                                @if (!string.IsNullOrWhiteSpace(item.LicensePlateImagePath))
                                {
                                    <a href="@item.LicensePlateImagePath" target="_blank">
                                        <img src="@item.LicensePlateImagePath" alt="Ảnh biển số" style="width:96px;height:60px;object-fit:cover;border-radius:10px;border:1px solid #e5e7eb" />
                                    </a>
                                }
                                else
                                {
                                    <span class="text-muted">Chưa có</span>
                                }
                            </td>
                            <td><span class="badge bg-warning text-dark rounded-pill px-3 py-2">@item.Status</span></td>
                            <td class="text-end">
                                <form asp-action="Approve" method="post" class="d-inline">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="id" value="@item.Id" />
                                    <button class="btn btn-sm btn-success rounded-3"><i class="bi bi-check2"></i> Duyệt</button>
                                </form>
                                <form asp-action="Reject" method="post" class="d-inline">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="id" value="@item.Id" />
                                    <button class="btn btn-sm btn-outline-danger rounded-3"><i class="bi bi-x"></i> Từ chối</button>
                                </form>
                            </td>
                        </tr>
                    }
                    @if (!Model.Any())
                    {
                        <tr><td colspan="7" class="text-center text-muted py-5">Không có đăng ký biển số chờ duyệt.</td></tr>
                    }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

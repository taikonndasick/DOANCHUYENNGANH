@model List<QuanLyKTX.Models.Building>
@{
    ViewData["Title"] = "Quản lý tòa nhà KTX";
    var keyword = ViewBag.Keyword as string ?? "";
    var status = ViewBag.Status as string ?? "Tất cả";
    var genderTarget = ViewBag.GenderTarget as string ?? "Tất cả";
    var currentPage = (int)(ViewBag.CurrentPage ?? 1);
    var totalPages = (int)(ViewBag.TotalPages ?? 1);
    var pageSize = (int)(ViewBag.PageSize ?? 20);
    var totalCount = (int)(ViewBag.TotalCount ?? Model.Count);
}

<div class="card border-0 shadow-sm rounded-4">
    <div class="card-header bg-white border-0 py-3 d-flex justify-content-between align-items-center">
        <div>
            <h5 class="fw-bold mb-1 text-dark"><i class="bi bi-building-fill me-2 text-primary"></i>Danh sách tòa nhà KTX</h5>
            <small class="text-muted">Tìm kiếm và lọc thông tin tòa nhà.</small>
        </div>
        <a asp-area="Admin" asp-controller="Building" asp-action="Create" class="btn btn-primary btn-sm rounded-pill px-3 shadow-sm">
            <i class="bi bi-plus-circle me-1"></i>Thêm tòa nhà
        </a>
    </div>

    <div class="card-body border-top">
        <form method="get" class="row g-2 align-items-end">
            <div class="col-md-4">
                <label class="form-label small text-muted">Từ khóa</label>
                <input name="keyword" value="@keyword" class="form-control rounded-3" placeholder="Mã tòa, tên tòa, địa chỉ..." />
            </div>
            <div class="col-md-2">
                <label class="form-label small text-muted">Trạng thái</label>
                <select name="status" class="form-select rounded-3">
                    <option value="Tất cả" selected="@(status == "Tất cả")">Tất cả</option>
                    <option value="Đang hoạt động" selected="@(status == "Đang hoạt động")">Đang hoạt động</option>
                    <option value="Ngưng hoạt động" selected="@(status == "Ngưng hoạt động")">Ngưng hoạt động</option>
                    <option value="Bảo trì" selected="@(status == "Bảo trì")">Bảo trì</option>
                </select>
            </div>
            <div class="col-md-2">
                <label class="form-label small text-muted">Khu</label>
                <select name="genderTarget" class="form-select rounded-3">
                    <option value="Tất cả" selected="@(genderTarget == "Tất cả")">Tất cả</option>
                    <option value="Nam" selected="@(genderTarget == "Nam")">Tòa nam</option>
                    <option value="Nữ" selected="@(genderTarget == "Nữ")">Tòa nữ</option>
                </select>
            </div>
            <div class="col-md-2">
                <label class="form-label small text-muted">Số dòng</label>
                <select name="pageSize" class="form-select rounded-3">
                    <option value="20" selected="@(pageSize == 20)">20</option>
                    <option value="50" selected="@(pageSize == 50)">50</option>
                    <option value="100" selected="@(pageSize == 100)">100</option>
                </select>
            </div>
            <div class="col-md-2 d-flex gap-2">
                <button class="btn btn-primary rounded-3 flex-fill"><i class="bi bi-search me-1"></i>Lọc</button>
                <a asp-action="Index" class="btn btn-outline-secondary rounded-3"><i class="bi bi-arrow-clockwise"></i></a>
            </div>
        </form>
    </div>

    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th class="ps-4">ID</th>
                        <th>Mã tòa</th>
                        <th>Tên tòa nhà</th>
                        <th>Địa chỉ</th>
                        <th>Số tầng</th>
                        <th>Số phòng</th>
                        <th>Trạng thái</th>
                        <th class="text-center pe-4">Thao tác</th>
                    </tr>
                </thead>
                <tbody>
                    @if (!Model.Any())
                    {
                        <tr><td colspan="8" class="text-center text-muted py-4"><i class="bi bi-inbox me-1"></i>Không có dữ liệu phù hợp.</td></tr>
                    }
                    else
                    {
                        foreach (var item in Model)
                        {
                            <tr>
                                <td class="ps-4 fw-bold text-muted">#@item.Id</td>
                                <td><span class="badge bg-primary-subtle text-primary fw-bold">@item.Code</span></td>
                                <td class="fw-bold">@item.Name</td>
                                <td>@(item.Address ?? "Chưa cập nhật")</td>
                                <td>@(item.TotalFloors?.ToString() ?? "Chưa cập nhật")</td>
                                <td><span class="badge bg-info-subtle text-info fw-bold">@(item.Apartments?.Count ?? 0) phòng</span></td>
                                <td><span class="badge @(item.Status == "Đang hoạt động" ? "bg-success-subtle text-success" : "bg-secondary-subtle text-secondary") fw-bold">@item.Status</span></td>
                                <td class="text-center pe-4">
                                    <a asp-area="Admin" asp-controller="Building" asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-outline-warning rounded-3"><i class="bi bi-pencil"></i> Sửa</a>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>

    <div class="card-footer bg-white border-0 py-3 d-flex justify-content-between align-items-center flex-wrap gap-2">
        <small class="text-muted">Hiển thị @Model.Count / @totalCount tòa nhà</small>
        <div class="btn-group btn-group-sm">
            <a class="btn btn-outline-secondary @(currentPage <= 1 ? "disabled" : "")" asp-action="Index" asp-route-keyword="@keyword" asp-route-status="@status" asp-route-genderTarget="@genderTarget" asp-route-page="@(currentPage - 1)" asp-route-pageSize="@pageSize">Trước</a>
            <span class="btn btn-light disabled">Trang @currentPage / @totalPages</span>
            <a class="btn btn-outline-secondary @(currentPage >= totalPages ? "disabled" : "")" asp-action="Index" asp-route-keyword="@keyword" asp-route-status="@status" asp-route-genderTarget="@genderTarget" asp-route-page="@(currentPage + 1)" asp-route-pageSize="@pageSize">Sau</a>
        </div>
    </div>
</div>

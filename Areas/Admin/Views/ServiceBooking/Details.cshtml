@model QuanLyKTX.Models.ServiceBooking

@{
    ViewData["Title"] = "Chi tiết yêu cầu dịch vụ";
}

<div class="container py-4">
    <div class="row">
        @* Tiêu đề trang *@
        <div class="col-12 mb-4">
            <h3 class="fw-bold text-dark">
                <i class="bi bi-info-circle-fill text-info me-2"></i>Chi tiết Booking #@Model.Id
            </h3>
            <p class="text-muted">Xem toàn bộ thông tin lịch hẹn và lịch sử yêu cầu của cư dân.</p>
        </div>
    </div>

    <div class="row">
        @* PHẦN CHÍNH (8 cột): Thông tin cư dân và dịch vụ *@
        <div class="col-lg-8 mb-4">
            <div class="card border-0 shadow-sm rounded-4">
                <div class="card-header bg-white border-0 pt-4 ps-4">
                    <h5 class="fw-bold mb-0">Nội dung yêu cầu</h5>
                </div>
                <div class="card-body p-4">
                    <div class="row mb-4">
                        <div class="col-md-6 mb-3 mb-md-0">
                            <label class="text-muted small fw-bold text-uppercase d-block mb-2">Cư dân yêu cầu</label>
                            <div class="d-flex align-items-center">
                                <div class="avatar-circle bg-primary-subtle text-primary me-3 d-flex align-items-center justify-content-center rounded-circle" style="width: 45px; height: 45px;">
                                    <i class="bi bi-person-fill fs-4"></i>
                                </div>
                                <div>
                                    <div class="fw-bold fs-5 text-dark">@Model.ResidentProfile?.FullName</div>
                                    <div class="text-muted small">Mã cư dân: #@Model.ResidentProfileId</div>
                                </div>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <label class="text-muted small fw-bold text-uppercase d-block mb-2">Dịch vụ cung cấp</label>
                            <div class="d-flex align-items-center">
                                <div class="avatar-circle bg-info-subtle text-info me-3 d-flex align-items-center justify-content-center rounded-circle" style="width: 45px; height: 45px;">
                                    <i class="bi bi-gear-wide-connected fs-4"></i>
                                </div>
                                <div>
                                    <div class="fw-bold fs-5 text-dark">@Model.Service?.Name</div>
                                    <div class="text-muted small">Phân loại kỹ thuật</div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <hr class="text-muted opacity-25">

                    <div class="mt-4">
                        <label class="text-muted small fw-bold text-uppercase d-block mb-2">Ghi chú chi tiết</label>
                        <div class="p-3 border-0 rounded-4 bg-light shadow-inner" style="min-height: 150px; font-style: italic;">
                            <i class="bi bi-quote text-secondary opacity-50 fs-2 d-block"></i>
                            <span class="text-dark">
                                @(string.IsNullOrEmpty(Model.Note) ? "Không có ghi chú nào được đính kèm cho yêu cầu này." : Model.Note)
                            </span>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        @* PHẦN PHỤ (4 cột): Trạng thái, Thời gian và Thao tác *@
        <div class="col-lg-4">
            @* Widget Trạng thái *@
            <div class="card border-0 shadow-sm rounded-4 mb-4">
                <div class="card-body p-4 text-center">
                    <h6 class="text-muted small fw-bold text-uppercase mb-3">Trạng thái xử lý</h6>
                    <div class="py-2 px-3 rounded-pill fw-bold d-inline-block mb-3 @GetStatusClass(Model.Status)">
                        @switch (Model.Status)
                        {
                            case "Pending":
                                <span>🕒 Chờ duyệt</span>
                                break;
                            case "Approved":

                                <span>✅ Đã phê duyệt</span>
                                break;
                            case "Done":

                                <span>🏁 Hoàn thành</span>
                                break;
                            case "Cancelled":

                                <span>❌ Đã hủy</span>
                                break;
                            default:

                                <span>@Model.Status</span>
                                break;
                        }
                    </div>

                    <div class="mt-2 pt-3 border-top w-100">
                        <label class="text-muted small fw-bold text-uppercase d-block mb-1">Thời gian đặt lịch</label>
                        <div class="fw-bold fs-5 text-dark">
                            <i class="bi bi-calendar-check me-1 text-primary"></i>
                            @Model.BookingDate.ToString("dd/MM/yyyy")
                        </div>
                        <div class="text-muted fs-6">
                            @Model.BookingDate.ToString("HH:mm")
                        </div>
                    </div>
                </div>
            </div>

            @* Nút Thao tác *@
            <div class="card border-0 shadow-sm rounded-4 mb-4 bg-dark text-white">
                <div class="card-body p-4 text-center">
                    <h6 class="text-white-50 small fw-bold text-uppercase mb-3">Thao tác quản lý</h6>
                    <div class="d-grid gap-2">
                        <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-warning btn-lg fw-bold rounded-3">
                            <i class="bi bi-pencil-square"></i> CHỈNH SỬA
                        </a>
                        <a asp-action="Index" class="btn btn-outline-light rounded-3">
                            <i class="bi bi-arrow-left"></i> Về danh sách
                        </a>
                    </div>
                </div>
            </div>

            @* Tips *@
            <div class="alert alert-warning border-0 rounded-4 shadow-sm p-3 small">
                <i class="bi bi-shield-lock me-2"></i>
                Dữ liệu chi tiết này được bảo mật và chỉ dành cho quản trị viên xem xét.
            </div>
        </div>
    </div>
</div>

@functions {
    string GetStatusClass(string status)
    {
        return status switch
        {
            "Pending" => "bg-warning-subtle text-warning border border-warning",
            "Approved" => "bg-primary-subtle text-primary border border-primary",
            "Done" => "bg-success-subtle text-success border border-success",
            "Cancelled" => "bg-danger-subtle text-danger border border-danger",
            _ => "bg-secondary-subtle text-secondary"
        };
    }
}
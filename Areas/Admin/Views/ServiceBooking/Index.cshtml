@model List<QuanLyKTX.Models.ServiceBooking>

@{
    ViewData["Title"] = "Yêu cầu dịch vụ";
    string keyword = ViewBag.Keyword as string ?? "";
    string status = ViewBag.Status as string ?? "Tất cả";
    string type = ViewBag.Type as string ?? "Tất cả";
}

<div class="card border-0 shadow-sm rounded-4">
    <div class="card-header bg-white border-0 py-3 d-flex justify-content-between align-items-center flex-wrap gap-2">
        <div>
            <h5 class="fw-bold mb-1 text-dark"><i class="bi bi-calendar-check me-2 text-primary"></i>Yêu cầu dịch vụ sinh viên</h5>
            <small class="text-muted">Duyệt các dịch vụ sinh viên đăng ký hoặc yêu cầu xử lý.</small>
        </div>
        <a asp-area="Admin" asp-controller="ServiceBooking" asp-action="Create" class="btn btn-primary btn-sm rounded-pill px-3 shadow-sm">
            <i class="bi bi-plus-lg me-1"></i>Tạo yêu cầu mới
        </a>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success mx-3 mt-3 mb-0 rounded-3">@TempData["Success"]</div>
    }
    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger mx-3 mt-3 mb-0 rounded-3">@TempData["Error"]</div>
    }

    <div class="card-body border-top">
        <form method="get" class="row g-2 align-items-end">
            <div class="col-lg-4 col-md-6">
                <label class="form-label small fw-bold text-muted">Tìm kiếm</label>
                <input name="keyword" value="@keyword" class="form-control" placeholder="Sinh viên, MSSV, dịch vụ..." />
            </div>
            <div class="col-lg-3 col-md-6">
                <label class="form-label small fw-bold text-muted">Trạng thái</label>
                <select name="status" class="form-select">
                    <option value="Tất cả" selected="@(status == "Tất cả")">Tất cả</option>
                    <option value="PendingPayment" selected="@(status == "PendingPayment")">Chờ thanh toán</option>
                    <option value="Pending" selected="@(status == "Pending")">Chờ xử lý</option>
                    <option value="Approved" selected="@(status == "Approved")">Đã duyệt</option>
                    <option value="Rejected" selected="@(status == "Rejected")">Từ chối</option>
                    <option value="Cancelled" selected="@(status == "Cancelled")">Đã hủy</option>
                </select>
            </div>
            <div class="col-lg-3 col-md-6">
                <label class="form-label small fw-bold text-muted">Loại dịch vụ</label>
                <select name="type" class="form-select">
                    <option value="Tất cả" selected="@(type == "Tất cả")">Tất cả</option>
                    <option value="Optional" selected="@(type == "Optional")">Sinh viên đăng ký</option>
                    <option value="Request" selected="@(type == "Request")">Yêu cầu xử lý</option>
                    <option value="Monthly" selected="@(type == "Monthly")">Hóa đơn tháng</option>
                </select>
            </div>
            <div class="col-lg-2 col-md-6 d-flex gap-2">
                <button class="btn btn-primary flex-fill" type="submit"><i class="bi bi-search"></i> Lọc</button>
                <a asp-action="Index" class="btn btn-outline-secondary"><i class="bi bi-arrow-clockwise"></i></a>
            </div>
        </form>
    </div>

    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th class="ps-4">ID</th>
                        <th>Sinh viên</th>
                        <th>Dịch vụ</th>
                        <th>Ngày gửi</th>
                        <th>Trạng thái</th>
                        <th>Ghi chú</th>
                        <th class="text-center pe-4">Thao tác</th>
                    </tr>
                </thead>
                <tbody>
                    @if (!Model.Any())
                    {
                        <tr><td colspan="7" class="text-center text-muted py-5">Không có yêu cầu dịch vụ phù hợp.</td></tr>
                    }
                    else
                    {
                        @foreach (var item in Model)
                        {
                            <tr>
                                <td class="ps-4 text-muted fw-bold">#@item.Id</td>
                                <td>
                                    <div class="fw-bold text-dark">@item.ResidentProfile?.FullName</div>
                                    <small class="text-muted">@item.ResidentProfile?.StudentCode</small>
                                    @if (item.ResidentProfile?.Apartment != null)
                                    {
                                        <small class="text-muted d-block">Phòng: @item.ResidentProfile.Apartment.ApartmentCode</small>
                                    }
                                </td>
                                <td>
                                    <div class="fw-bold">@item.Service?.Name</div>
                                    <small class="text-muted">@item.Service?.Price.ToString("N0") đ</small>
                                </td>
                                <td>
                                    <div>@item.BookingDate.ToString("dd/MM/yyyy")</div>
                                    <small class="text-muted">@item.BookingDate.ToString("HH:mm")</small>
                                </td>
                                <td>
                                    @switch (item.Status)
                                    {
                                        case "PendingPayment":
                                            <span class="badge bg-warning-subtle text-warning rounded-pill px-3">Chờ thanh toán</span>
                                            break;
                                        case "Pending":
                                            <span class="badge bg-warning-subtle text-warning rounded-pill px-3">Chờ xử lý</span>
                                            break;
                                        case "Approved":
                                        case "Active":
                                            <span class="badge bg-success-subtle text-success rounded-pill px-3">Đã duyệt</span>
                                            break;
                                        case "Rejected":
                                            <span class="badge bg-danger-subtle text-danger rounded-pill px-3">Từ chối</span>
                                            break;
                                        case "Cancelled":
                                            <span class="badge bg-secondary-subtle text-secondary rounded-pill px-3">Đã hủy</span>
                                            break;
                                        default:
                                            <span class="badge bg-secondary-subtle text-secondary rounded-pill px-3">@item.Status</span>
                                            break;
                                    }
                                </td>
                                <td>
                                    <small class="text-muted d-inline-block" style="max-width: 220px;">@(string.IsNullOrWhiteSpace(item.Note) ? "---" : item.Note)</small>
                                </td>
                                <td class="text-center pe-4">
                                    <div class="d-flex justify-content-center gap-2 flex-wrap">
                                        <a asp-area="Admin" asp-controller="ServiceBooking" asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-outline-info" title="Chi tiết"><i class="bi bi-eye"></i></a>
                                        @if (item.Status == "Pending" || item.Status == "PendingPayment")
                                        {
                                            <form asp-action="Approve" method="post" class="d-inline">
                                                @Html.AntiForgeryToken()
                                                <input type="hidden" name="id" value="@item.Id" />
                                                <button class="btn btn-sm btn-outline-success" title="Duyệt" onclick="return confirm('Duyệt yêu cầu dịch vụ này?')"><i class="bi bi-check-lg"></i></button>
                                            </form>
                                            <form asp-action="Reject" method="post" class="d-inline">
                                                @Html.AntiForgeryToken()
                                                <input type="hidden" name="id" value="@item.Id" />
                                                <button class="btn btn-sm btn-outline-danger" title="Từ chối" onclick="return confirm('Từ chối yêu cầu dịch vụ này?')"><i class="bi bi-x-lg"></i></button>
                                            </form>
                                        }
                                        <a asp-area="Admin" asp-controller="ServiceBooking" asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-outline-warning" title="Sửa"><i class="bi bi-pencil"></i></a>
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
    <div class="card-footer bg-white border-0 py-3">
        <small class="text-muted">Đang hiển thị @Model.Count yêu cầu dịch vụ</small>
    </div>
</div>

@model List<QuanLyKTX.Models.Service>

@{
    ViewData["Title"] = "Danh sách dịch vụ";
    string keyword = ViewBag.Keyword as string ?? "";
    string type = ViewBag.Type as string ?? "Tất cả";
    decimal? minPrice = ViewBag.MinPrice as decimal?;
    decimal? maxPrice = ViewBag.MaxPrice as decimal?;
}

<div class="card border-0 shadow-sm rounded-4">
    <div class="card-header bg-white border-0 py-3 d-flex justify-content-between align-items-center flex-wrap gap-2">
        <div>
            <h5 class="fw-bold mb-1 text-dark">
                <i class="bi bi-gear-wide-connected me-2 text-primary"></i>Danh mục dịch vụ KTX
            </h5>
            <small class="text-muted">Không bao gồm tiền phòng vì tiền phòng xử lý tại quy trình đăng ký cư trú.</small>
        </div>
        <a asp-area="Admin" asp-controller="Service" asp-action="Create" class="btn btn-primary btn-sm rounded-pill px-3 shadow-sm">
            <i class="bi bi-plus-lg me-1"></i>Thêm dịch vụ
        </a>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success mx-3 mt-3 mb-0 rounded-3">@TempData["Success"]</div>
    }
    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger mx-3 mt-3 mb-0 rounded-3">@TempData["Error"]</div>
    }

    <div class="card-body border-top">
        <form method="get" class="row g-2 align-items-end">
            <div class="col-lg-4 col-md-6">
                <label class="form-label small fw-bold text-muted">Tìm kiếm</label>
                <input name="keyword" value="@keyword" class="form-control" placeholder="Tên dịch vụ, mô tả..." />
            </div>
            <div class="col-lg-2 col-md-6">
                <label class="form-label small fw-bold text-muted">Loại dịch vụ</label>
                <select name="type" class="form-select">
                    <option value="Tất cả" selected="@(type == "Tất cả")">Tất cả</option>
                    <option value="Monthly" selected="@(type == "Monthly")">Tính vào hóa đơn tháng</option>
                    <option value="Optional" selected="@(type == "Optional")">Sinh viên đăng ký</option>
                    <option value="Request" selected="@(type == "Request")">Yêu cầu xử lý</option>
                </select>
            </div>
            <div class="col-lg-2 col-md-6">
                <label class="form-label small fw-bold text-muted">Giá từ</label>
                <input name="minPrice" value="@(minPrice?.ToString("0"))" type="number" class="form-control" placeholder="0" />
            </div>
            <div class="col-lg-2 col-md-6">
                <label class="form-label small fw-bold text-muted">Giá đến</label>
                <input name="maxPrice" value="@(maxPrice?.ToString("0"))" type="number" class="form-control" placeholder="100000" />
            </div>
            <div class="col-lg-2 col-md-12 d-flex gap-2">
                <button class="btn btn-primary flex-fill" type="submit"><i class="bi bi-search"></i> Lọc</button>
                <a asp-action="Index" class="btn btn-outline-secondary"><i class="bi bi-arrow-clockwise"></i></a>
            </div>
        </form>
    </div>

    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th class="ps-4">ID</th>
                        <th>Tên dịch vụ</th>
                        <th>Mô tả</th>
                        <th class="text-end">Đơn giá</th>
                        <th>Loại</th>
                        <th class="text-center pe-4">Thao tác</th>
                    </tr>
                </thead>
                <tbody>
                    @if (!Model.Any())
                    {
                        <tr>
                            <td colspan="6" class="text-center text-muted py-5">Chưa có dịch vụ phù hợp bộ lọc.</td>
                        </tr>
                    }
                    else
                    {
                        foreach (var s in Model)
                        {
                            <tr>
                                <td class="ps-4 text-muted fw-bold">#@s.Id</td>
                                <td class="fw-bold text-dark">@s.Name</td>
                                <td class="text-muted small" style="max-width: 420px;">@s.Description</td>
                                <td class="text-end fw-bold text-primary">@s.Price.ToString("N0") đ</td>
                                <td>
                                    @switch (s.Type)
                                    {
                                        case "Monthly":
                                            <span class="badge bg-info-subtle text-info rounded-pill px-3">Hóa đơn tháng</span>
                                            break;
                                        case "Optional":
                                            <span class="badge bg-primary-subtle text-primary rounded-pill px-3">Sinh viên đăng ký</span>
                                            break;
                                        case "Request":
                                            <span class="badge bg-warning-subtle text-warning rounded-pill px-3">Yêu cầu xử lý</span>
                                            break;
                                        default:
                                            <span class="badge bg-secondary-subtle text-secondary rounded-pill px-3">@s.Type</span>
                                            break;
                                    }
                                </td>
                                <td class="text-center pe-4">
                                    <div class="d-flex justify-content-center gap-2">
                                        <a asp-area="Admin" asp-controller="Service" asp-action="Details" asp-route-id="@s.Id" class="btn btn-sm btn-outline-info" title="Chi tiết"><i class="bi bi-eye"></i></a>
                                        <a asp-area="Admin" asp-controller="Service" asp-action="Edit" asp-route-id="@s.Id" class="btn btn-sm btn-outline-warning" title="Sửa"><i class="bi bi-pencil"></i></a>
                                        <a asp-area="Admin" asp-controller="Service" asp-action="Delete" asp-route-id="@s.Id" class="btn btn-sm btn-outline-danger" title="Xóa"><i class="bi bi-trash"></i></a>
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>

    <div class="card-footer bg-white border-0 py-3">
        <small class="text-muted">Đang hiển thị @Model.Count dịch vụ tiện ích. Tiền phòng không nằm trong danh mục này.</small>
    </div>
</div>

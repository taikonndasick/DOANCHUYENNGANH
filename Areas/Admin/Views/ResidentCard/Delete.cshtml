@model QuanLyKTX.Models.ResidentCard

@{
    ViewData["Title"] = "Xác nhận xóa thẻ";
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-md-6 col-lg-5">
            <div class="card border-0 shadow-lg rounded-4 overflow-hidden">
                <div class="card-body p-5 text-center">
                    <div class="mb-4">
                        <i class="bi bi-trash3 text-danger display-1"></i>
                    </div>
                    <h3 class="fw-bold text-dark">Thu hồi thẻ?</h3>
                    <p class="text-muted">Bạn có chắc chắn muốn xóa vĩnh viễn thẻ cư dân này? Hành động này sẽ hủy bỏ mọi quyền ra vào của cư dân liên quan.</p>

                    <div class="p-4 bg-light rounded-4 my-4 text-start border">
                        <div class="d-flex justify-content-between mb-2">
                            <span class="text-muted small fw-bold">MÃ THẺ:</span>
                            <span class="fw-bold text-primary">#@Model.CardCode</span>
                        </div>
                        <div class="col-12 mb-2">
                            <span class="text-muted small fw-bold">CHỦ THẺ:</span>
                            <div class="fw-bold">@Model.ResidentProfile?.FullName</div>
                        </div>
                        <div class="d-flex justify-content-between">
                            <span class="text-muted small fw-bold">TRẠNG THÁI:</span>
                            <span class="badge @(Model.Status == "Active" ? "bg-success" : "bg-danger")">@Model.Status</span>
                        </div>
                    </div>

                    <form asp-action="Delete">
                        @Html.AntiForgeryToken()
                        <input type="hidden" asp-for="Id" />
                        <div class="d-grid gap-3">
                            <button type="submit" class="btn btn-danger btn-lg rounded-pill fw-bold py-3 shadow-sm">
                                <i class="bi bi-trash-fill me-2"></i>XÁC NHẬN XÓA
                            </button>
                            <a asp-action="Index" class="btn btn-link text-secondary text-decoration-none fw-bold">
                                Không, quay lại danh sách
                            </a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>
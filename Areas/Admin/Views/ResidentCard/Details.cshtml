@model QuanLyKTX.Models.ResidentCard

@{
    ViewData["Title"] = "Chi tiết thẻ cư dân #" + Model.CardCode;
}

<div class="container py-4">
    <div class="row">
        @* Tiêu đề chính *@
        <div class="col-12 mb-4">
            <div class="d-flex justify-content-between align-items-center">
                <div>
                    <h3 class="fw-bold text-dark">
                        <i class="bi bi-id-card-identity text-primary me-2"></i>Hồ sơ thẻ cư dân
                    </h3>
                    <p class="text-muted">Thông tin định danh và quyền truy cập tiện ích của cư dân.</p>
                </div>
                <div>
                    <span class="badge @(Model.Status == "Active" ? "bg-success" : "bg-danger") px-4 py-2 rounded-pill fs-6 shadow-sm">
                        <i class="bi @(Model.Status == "Active" ? "bi-check-circle" : "bi-x-circle") me-1"></i>
                        @(Model.Status == "Active" ? "Đang hoạt động" : "Bị khóa/Hết hạn")
                    </span>
                </div>
            </div>
        </div>
    </div>

    <div class="row">
        @* CỘT TRÁI: Thông tin cá nhân & Thẻ *@
        <div class="col-lg-8">
            <div class="card border-0 shadow-sm rounded-4 mb-4">
                <div class="card-header bg-white border-0 pt-4 ps-4">
                    <h5 class="fw-bold mb-0">Thông tin chi tiết</h5>
                </div>
                <div class="card-body p-4">
                    @* Khối 1: Định danh thẻ *@
                    <div class="row mb-4 border-bottom pb-3">
                        <div class="col-sm-6 mb-3 mb-sm-0">
                            <label class="text-muted small fw-bold text-uppercase">Mã số thẻ (UID)</label>
                            <p class="fs-5 fw-bold text-primary mb-0">@Model.CardCode</p>
                        </div>
                        <div class="col-sm-6">
                            <label class="text-muted small fw-bold text-uppercase">Họ tên cư dân</label>
                            <p class="fs-5 fw-bold text-dark mb-0">@Model.ResidentProfile?.FullName</p>
                        </div>
                    </div>

                    @* Khối 2: Căn hộ & CCCD *@
                    <div class="row mb-4 border-bottom pb-3">
                        <div class="col-sm-6 mb-3 mb-sm-0">
                            <label class="text-muted small fw-bold text-uppercase">Căn hộ liên kết</label>
                            <div class="mt-1">
                                @if (Model.ResidentProfile?.Apartment != null)
                                {
                                    <span class="badge bg-info-subtle text-info-emphasis px-3 py-2 border border-info">
                                        <i class="bi bi-building me-1"></i> @Model.ResidentProfile.Apartment.ApartmentCode
                                    </span>
                                }
                                else
                                {
                                    <span class="text-muted small">N/A</span>
                                }
                            </div>
                        </div>
                        <div class="col-sm-6">
                            <label class="text-muted small fw-bold text-uppercase">Số CCCD / Passport</label>
                            <p class="fw-bold text-dark mt-1">@Model.ResidentProfile?.NationalId</p>
                        </div>
                    </div>

                    @* Khối 3: Phương tiện *@
                    <div class="mt-2">
                        <label class="text-muted small fw-bold text-uppercase mb-3 d-block">Phương tiện liên kết (Dùng thẻ để gửi xe)</label>
                        @if (Model.ResidentProfile?.Vehicles != null && Model.ResidentProfile.Vehicles.Any())
                        {
                            <div class="row g-3">
                                @foreach (var vehicle in Model.ResidentProfile.Vehicles)
                                {
                                    <div class="col-md-6">
                                        <div class="d-flex align-items-center p-3 bg-light rounded-3 border">
                                            <div class="bg-white p-2 rounded-circle me-3 shadow-sm">
                                                <i class="bi @(vehicle.VehicleType.Contains("xe máy") ? "bi-bicycle" : "bi-car-front") text-primary"></i>
                                            </div>
                                            <div>
                                                <div class="fw-bold">@vehicle.LicensePlate</div>
                                                <small class="text-muted">@vehicle.VehicleType</small>
                                            </div>
                                        </div>
                                    </div>
                                }
                            </div>
                        }
                        else
                        {
                            <div class="alert alert-light border border-dashed text-center py-4">
                                <i class="bi bi-info-circle text-muted d-block fs-3 mb-2"></i>
                                <span class="text-muted small">Cư dân chưa đăng ký phương tiện liên kết với thẻ này.</span>
                            </div>
                        }
                    </div>
                </div>
                <div class="card-footer bg-white border-0 pb-4 ps-4">
                    <a asp-area="Admin" asp-controller="ResidentCard" asp-action="Index" class="btn btn-outline-secondary rounded-pill px-4">
                        <i class="bi bi-arrow-left me-1"></i> Quay lại
                    </a>
                    <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-warning rounded-pill px-4 ms-2 text-dark fw-bold">
                        <i class="bi bi-pencil-square me-1"></i> Chỉnh sửa thẻ
                    </a>
                </div>
            </div>
        </div>

        @* CỘT PHẢI: Thời hạn & Hành động *@
        <div class="col-lg-4">
            <div class="card border-0 shadow-sm rounded-4 mb-4">
                <div class="card-body p-4">
                    <h6 class="fw-bold mb-4">Quản lý thời hạn</h6>

                    <div class="d-flex mb-4">
                        <div class="text-success me-3">
                            <i class="bi bi-calendar-check fs-4"></i>
                        </div>
                        <div>
                            <label class="text-muted small d-block">Ngày phát hành</label>
                            <span class="fw-bold">@Model.IssueDate.ToString("dd/MM/yyyy")</span>
                        </div>
                    </div>

                    <div class="d-flex mb-4">
                        <div class="text-danger me-3">
                            <i class="bi bi-calendar-x fs-4"></i>
                        </div>
                        <div>
                            <label class="text-muted small d-block">Ngày hết hạn</label>
                            <span class="fw-bold">@(Model.ExpiryDate?.ToString("dd/MM/yyyy") ?? "Vô thời hạn")</span>
                        </div>
                    </div>

                    <hr class="opacity-25">

                    @* Widget Thông tin thêm *@
                    <div class="mt-4">
                        <div class="d-flex align-items-center p-3 rounded-3 bg-primary-subtle border border-primary-subtle text-primary">
                            <i class="bi bi-shield-check fs-3 me-3"></i>
                            <div class="small fw-bold">Thẻ đã được mã hóa dữ liệu an toàn</div>
                        </div>
                    </div>
                </div>
            </div>

            @* Quick Action Alert *@
            <div class="alert alert-warning border-0 shadow-sm rounded-4 p-4">
                <h6 class="fw-bold mb-2"><i class="bi bi-exclamation-triangle me-2"></i>Quy trình cấp lại</h6>
                <small class="d-block mb-3 text-dark">Nếu thẻ bị mất, vui lòng khóa thẻ ngay lập tức để bảo đảm an ninh cho căn hộ.</small>
                <button type="button" class="btn btn-danger btn-sm w-100 rounded-3 fw-bold py-2 shadow-sm">
                    <i class="bi bi-lock-fill me-1"></i> KHÓA THẺ KHẨN CẤP
                </button>
            </div>
        </div>
    </div>
</div>

<style>
    .bg-info-subtle {
        background-color: rgba(13, 202, 240, 0.1) !important;
    }

    .bg-primary-subtle {
        background-color: rgba(15, 76, 129, 0.1) !important;
    }

    .border-dashed {
        border-style: dashed !important;
    }
</style>